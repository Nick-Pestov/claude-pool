#!/usr/bin/env python3
"""claude-pool: see what every Claude Code session costs on your Mac, and close what nobody is using.

  claude-pool              live monitor: per-core CPU, memory, every Claude Code session's CPU and RAM, and the idle
                           sessions and leftover processes you can close (keys: x close one, X close all idle)
  claude-pool --once       one text snapshot
  claude-pool --agent      JSON lines for the menu bar app (PoolBar)
  claude-pool doctor       check this is set up right (Python, Claude CLI, permissions)
  claude-pool --close <spec>...   close idle sessions or leftover processes (what the menu bar's Close runs)

Everything runs on this Mac and reads only this Mac. It never sends anything anywhere. A Claude session's CPU is the
whole process tree it started (its tools, MCP servers, shells), so you see the real cost. "Leftover" processes are
ones macOS kept alive after the Claude session that started them ended - dev servers, test browsers, MCP servers,
tool shells. Closing a session keeps its conversation (resume it with `claude --resume`).

Config (optional) at ~/.config/claude-pool/config.json:
  {"close_idle_hours": 24, "leftover_min_minutes": 10, "protect": ["my-always-on-thing"]}
protect is a list of substrings; any process whose command line or folder contains one is never offered for closing.
"""
from __future__ import annotations

import collections
import ctypes
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = str(Path.home())
STATE = Path(HOME, ".local/state/claude-pool")
CONFIG = Path(HOME, ".config/claude-pool/config.json")
GB, MB = 1024 ** 3, 1024 ** 2
VERSION = "0.1"


def config():
    try:
        c = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        c = {}
    return {"close_idle_hours": c.get("close_idle_hours", 24),
            "leftover_min_minutes": c.get("leftover_min_minutes", 10),
            "protect": [str(p) for p in c.get("protect", [])]}


def log(msg):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "claude-pool.log", "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")


def sh(cmd, timeout=30):
    try:
        return subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, timeout=timeout).stdout
    except subprocess.TimeoutExpired:
        return ""


def claude_bin():
    """Path to the Claude Code CLI, or just 'claude' if it's on PATH."""
    for p in (HOME + "/.local/bin/claude", "/opt/homebrew/bin/claude", "/usr/local/bin/claude"):
        if os.path.exists(p):
            return p
    return "claude"


CLAUDE = claude_bin()
ENVLINE = f'export PATH="{HOME}/.local/bin:/opt/homebrew/bin:$PATH"; '


# --- sampling this Mac ---

class Cores:
    """Busy share of each core between calls, from the kernel's tick counters (host_processor_info; no admin)."""

    def __init__(self):
        lib = ctypes.CDLL("/usr/lib/libSystem.dylib")
        lib.mach_host_self.restype = ctypes.c_uint
        lib.host_processor_info.argtypes = [ctypes.c_uint, ctypes.c_int, ctypes.POINTER(ctypes.c_uint),
                                            ctypes.POINTER(ctypes.POINTER(ctypes.c_int)), ctypes.POINTER(ctypes.c_uint)]
        lib.vm_deallocate.argtypes = [ctypes.c_uint, ctypes.c_size_t, ctypes.c_size_t]
        self.lib, self.host = lib, lib.mach_host_self()
        self.task = ctypes.c_uint.in_dll(lib, "mach_task_self_").value
        self.prev = self.ticks()

    def ticks(self):
        count, info, n = ctypes.c_uint(), ctypes.POINTER(ctypes.c_int)(), ctypes.c_uint()
        if self.lib.host_processor_info(self.host, 2, ctypes.byref(count), ctypes.byref(info), ctypes.byref(n)):
            return []
        out = [[info[i * 4 + j] & 0xFFFFFFFF for j in range(4)] for i in range(count.value)]
        self.lib.vm_deallocate(self.task, ctypes.cast(info, ctypes.c_void_p).value, n.value * 4)
        return out

    def usage(self):
        now, out = self.ticks(), []
        for a, b in zip(self.prev, now):
            d = [(y - x) & 0xFFFFFFFF for x, y in zip(a, b)]
            out.append(round(1 - d[2] / sum(d), 3) if sum(d) else 0.0)
        self.prev = now
        return out


def sysctl(name):
    return subprocess.run(["sysctl", "-n", name], capture_output=True, text=True).stdout.strip()


def layout():
    """This Mac's chip and its cores in clusters (fastest tier first)."""
    n = int(sysctl("hw.ncpu"))
    fast = int(sysctl("hw.perflevel0.logicalcpu") or n)
    slow = n - fast
    clusters = []
    for level, first, size in ((0, slow, fast), (1, 0, slow)):
        name = sysctl(f"hw.perflevel{level}.name") or ("fast", "slow")[level]
        per = int(sysctl(f"hw.perflevel{level}.cpusperl2") or 0) or size or 1
        clusters += [[name, list(range(i, min(i + per, first + size)))] for i in range(first, first + size, per)]
    return {"chip": sysctl("machdep.cpu.brand_string"), "ncpu": n, "clusters": clusters}


def memory():
    vm = subprocess.run(["vm_stat"], capture_output=True, text=True).stdout
    page = re.search(r"page size of (\d+)", vm)
    page = int(page.group(1)) if page else 16384
    v = {k.strip('"'): int(x) * page for k, x in re.findall(r"^([^:\n]+):\s+(\d+)\.$", vm, re.M)}
    out = subprocess.run(["sysctl", "-n", "hw.memsize", "vm.swapusage", "kern.memorystatus_level"],
                         capture_output=True, text=True).stdout.splitlines() + ["", "", ""]
    swap = re.search(r"used = ([\d.]+)M", out[1])
    app = v.get("Anonymous pages", 0) - v.get("Pages purgeable", 0)
    used = app + v.get("Pages wired down", 0) + v.get("Pages occupied by compressor", 0)
    return {"total": int(out[0]) if out[0].isdigit() else 1, "used": used, "swap": float(swap.group(1)) * MB if swap else 0.0,
            "level": int(out[2]) if out[2].strip().isdigit() else 100}


def cpu_seconds(text):
    days, _, text = text.rpartition("-")
    secs = 0.0
    for part in text.split(":"):
        secs = secs * 60 + float(part)
    return (int(days) if days else 0) * 86400 + secs


def processes():
    """{pid: (ppid, cpu seconds, resident bytes, exe, seconds since start)}."""
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,time=,etime=,rss=,comm="], capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        f = line.split(None, 5)
        if len(f) == 6 and f[0].isdigit():
            try:
                procs[int(f[0])] = (int(f[1]), cpu_seconds(f[2]), int(f[4]) * 1024, f[5], cpu_seconds(f[3]))
            except ValueError:
                pass
    return procs


def app_name(path):
    m = re.search(r"([^/]+)\.app/", path)
    return m.group(1) if m else os.path.basename(path)


# Claude Code's own background machinery, which the CLI needs running - never offered for closing.
CLAUDE_INTERNAL = re.compile(r"claude (bg-spare|bg-pty-host)|/claude daemon")
CLAUDE_SHELL = re.compile(r"shell-snapshots/snapshot-")
DEV_EXE = re.compile(r"^(node|bun|deno|python\d*(\.\d+)?|Python|pnpm|npm|npx|yarn|java|ruby|esbuild|tsx|vite|vitest|jest|"
                     r"next-server.*|uvicorn|gunicorn|pytest|chrome-headless-shell|Google Chrome for Testing|Chromium|"
                     r"chromedriver|ffmpeg|redis-server|postgres|rails|flask|webpack)$")


class Sampler:
    def __init__(self):
        self.static = layout()
        self.cores = Cores()
        self.prev_cpu, self.prev_t = {}, None
        self.cfg = config()

    def agents(self):
        out = sh(ENVLINE + f"{CLAUDE} agents --json 2>/dev/null || echo '[]'")
        try:
            return json.loads(out or "[]")
        except ValueError:
            return []

    def sample(self):
        now = time.time()
        procs = processes()
        agents = self.agents()
        launchd = {int(f[0]) for f in (l.split() for l in sh("launchctl list").splitlines()[1:]) if f and f[0].isdigit()}
        dt = now - self.prev_t if self.prev_t else 0
        ncpu = self.static["ncpu"]
        rate = {}
        for pid, (_, cpu, _, _, _) in procs.items():
            before = self.prev_cpu.get(pid, cpu)
            rate[pid] = min(ncpu, max(0.0, cpu - before) / dt) if dt else 0.0
        self.prev_cpu, self.prev_t = {pid: p[1] for pid, p in procs.items()}, now
        kids = collections.defaultdict(list)
        for pid, p in procs.items():
            kids[p[0]].append(pid)

        def tree(root):
            out, todo = [], [root]
            while todo:
                p = todo.pop()
                out.append(p)
                todo += kids.get(p, [])
            return out

        def idle_of(sid):
            for base in (HOME + "/.claude/projects", HOME + "/.claude-personal/projects"):
                if not os.path.isdir(base):
                    continue
                for path in Path(base).glob(f"*/{sid}.jsonl"):
                    try:
                        return now - os.stat(path).st_mtime
                    except OSError:
                        return None
            return None

        sessions, claimed, seen = [], set(), set()
        for a in agents:
            pid = int(a.get("pid") or 0)
            sid = a.get("sessionId") or ""
            if pid not in procs or pid in seen or not sid:
                continue
            seen.add(pid)
            t = tree(pid)
            claimed.update(t)
            sessions.append({"sid": sid, "pid": pid, "id": a.get("id") or "", "name": a.get("name") or "",
                             "kind": a.get("kind") or "", "status": a.get("status") or "", "cwd": a.get("cwd") or "",
                             "cpu": round(sum(rate[p] for p in t), 3), "rss": sum(procs[p][2] for p in t),
                             "idle": idle_of(sid)})
        leftovers = self.find_leftovers(procs, rate, tree, launchd, now)
        apps = collections.defaultdict(lambda: [0.0, 0])
        for pid, (_, _, rss, comm, _) in procs.items():
            if pid not in claimed:
                a = apps[app_name(comm)]
                a[0] += rate[pid]
                a[1] += rss
        top = sorted(([n, round(c, 2), r] for n, (c, r) in apps.items()), key=lambda x: -x[1])[:6]
        return {"ts": now, **self.static, "cores": self.cores.usage(), "load": os.getloadavg(), "mem": memory(),
                "sessions": sessions, "leftovers": leftovers, "apps": top}

    def find_leftovers(self, procs, rate, tree, launchd, now):
        """Process trees whose Claude session is gone: launchd adopted them (parent 1), they've run a while, and
        they're a dev runtime or a Claude Bash-tool shell. Never Claude's own machinery, launchd services, or
        anything matching a protect substring."""
        floor = self.cfg["leftover_min_minutes"] * 60
        cands = [pid for pid, p in procs.items() if p[0] == 1 and pid not in launchd and p[4] >= floor
                 and (os.path.basename(p[3]) in ("zsh", "bash", "sh") or DEV_EXE.match(os.path.basename(p[3])))]
        if not cands:
            return []
        trees = {pid: tree(pid) for pid in cands}
        every = sorted({p for t in trees.values() for p in t})
        args, cwd = {}, {}
        for line in sh("ps -o pid=,args= -p " + ",".join(map(str, every))).splitlines():
            pid, _, a = line.strip().partition(" ")
            if pid.isdigit():
                args[int(pid)] = a.strip()
        cur = None
        for line in sh("lsof -a -d cwd -Fpn -p " + ",".join(map(str, cands))).splitlines():
            if line.startswith("p"):
                cur = int(line[1:])
            elif line.startswith("n") and cur:
                cwd[cur] = line[1:]
        out = []
        for pid in cands:
            a, t = args.get(pid, ""), trees[pid]
            base = os.path.basename(procs[pid][3])
            if base in ("zsh", "bash", "sh") and not CLAUDE_SHELL.search(a):
                continue
            if any(CLAUDE_INTERNAL.search(args.get(p, "")) or os.path.basename(procs[p][3]).startswith("claude")
                   for p in t if p in procs):
                continue
            if any(prot and (prot in args.get(p, "") or prot in cwd.get(pid, "")) for p in t for prot in self.cfg["protect"]):
                continue
            out.append({"pid": pid, "start": round(now - procs[pid][4]), "age": round(procs[pid][4]),
                        "cpu": round(sum(rate.get(p, 0) for p in t), 3), "rss": sum(procs[p][2] for p in t if p in procs),
                        "cwd": cwd.get(pid, ""), "n": len(t), "what": describe(t, args)})
        return sorted(out, key=lambda o: -o["rss"])


def describe(pids, args):
    names = []
    for p in pids:
        argv = (args.get(p) or "").split()
        if not argv:
            continue
        exe = os.path.basename(argv[0])
        if exe in ("zsh", "bash", "sh", "sleep", "caffeinate", "cat", "tail"):
            continue
        rest = [a for a in argv[1:] if not a.startswith("-")][:1]
        name = exe + (" " + os.path.basename(rest[0]) if rest else "")
        if name not in names:
            names.append(name)
    return ", ".join(names[:3]) + (f" +{len(names) - 3} more" if len(names) > 3 else "") if names \
        else "a shell loop left by a Claude session"


# --- formatting helpers ---

def gb(n):
    return f"{n / GB:.1f} GB" if n >= GB else f"{n / MB:.0f} MB"


def cores(n):
    return f"{n:.2f}" if n < 0.995 else f"{n:.1f}"


def ago(secs):
    if secs is None:
        return "?"
    if secs < 60:
        return "now"
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return "now"


def short(text, n):
    return text if len(text) <= n else text[: n - 1] + "…"


# --- what nobody is using ---

def cleanup(sample):
    """Idle sessions (between turns, untouched past close_idle_hours) and leftover processes, biggest first.
    Each item has a spec the --close action understands."""
    cfg = config()
    floor = cfg["close_idle_hours"] * 3600
    items = []
    for s in sample["sessions"]:
        if s["status"] != "idle" or (s["idle"] or 0) < floor:
            continue
        closable = s["kind"] == "background"   # only background sessions can be stopped from here
        note = (f"conversation kept: claude attach {s.get('id') or s['sid'][:8]}" if closable
                else f"conversation kept: claude --resume {s['sid'][:8]} (close its tab to end it)")
        items.append({"key": "s:" + s["sid"][:8], "kind": "session", "label": s["name"] or s["sid"][:8],
                      "detail": f"idle {ago(s['idle'])}, {gb(s['rss'])}", "note": note, "rss": s["rss"],
                      "closable": closable, "spec": "|".join(["session", s["sid"], str(s["pid"]), s["kind"], s.get("id") or ""])})
    for o in sample["leftovers"]:
        items.append({"key": f"p:{o['pid']}:{o['start']}", "kind": "leftover", "label": o["what"],
                      "detail": f"no session, running {ago(o['age'])}, {gb(o['rss'])}"
                                + (f", {cores(o['cpu'])} cores" if o["cpu"] >= 0.1 else ""),
                      "note": "in " + (o["cwd"].replace(HOME, "~") or "?"), "rss": o["rss"], "closable": True,
                      "spec": f"procs|{o['pid']}|{o['start']}"})
    return sorted(items, key=lambda i: -i["rss"])


def kill_tree(root, grace=5.0):
    procs = processes()
    kids = collections.defaultdict(list)
    for pid, p in procs.items():
        kids[p[0]].append(pid)
    tree, todo = [], [root]
    while todo:
        p = todo.pop()
        tree.append(p)
        todo += kids.get(p, [])

    def alive(pids):
        out = []
        for p in pids:
            try:
                os.kill(p, 0)
                out.append(p)
            except OSError:
                pass
        return out

    for step, sig, wait in ((0, signal.SIGTERM, grace), (1, signal.SIGTERM, 2.0), (2, signal.SIGKILL, 1.0)):
        targets = alive([root] if step == 0 else tree)
        if not targets:
            break
        for p in targets:
            try:
                os.kill(p, sig)
            except OSError:
                pass
        deadline = time.time() + wait
        while time.time() < deadline and alive(targets):
            time.sleep(0.2)
    return len(tree)


def close_one(spec):
    f = (spec.split("|") + [""] * 5)[:5]
    if f[0] == "session":
        sid, pid, kind, short_id = f[1], int(f[2] or 0), f[3], f[4]
        out = sh(ENVLINE + f"{CLAUDE} agents --json 2>/dev/null || echo '[]'")
        try:
            live = [a for a in json.loads(out or "[]") if a.get("sessionId") == sid and int(a.get("pid") or 0) == pid]
        except ValueError:
            live = []
        if not live:
            return True, f"{sid[:8]} had already ended"
        if kind == "background" and short_id:
            sh(ENVLINE + f"{CLAUDE} stop {short_id} 2>&1")
            deadline = time.time() + 8
            while time.time() < deadline:
                try:
                    os.kill(pid, 0)
                except OSError:
                    return True, f"stopped {sid[:8]}"
                time.sleep(0.3)
            kill_tree(pid)
            return True, f"closed {sid[:8]}"
        return False, f"{sid[:8]} is an interactive session - close its terminal tab to end it"
    if f[0] == "procs":
        pid, start = int(f[1] or 0), int(f[2] or 0)
        p = processes().get(pid)
        if not p or p[0] != 1 or abs((time.time() - p[4]) - start) > 15:
            return True, f"process {pid} had already gone"
        n = kill_tree(pid)
        return True, f"closed process {pid}" + (f" and {n - 1} under it" if n > 1 else "")
    return False, f"don't know how to close {spec!r}"


def close(specs):
    results = [close_one(s) for s in specs]
    ok = all(r[0] for r in results)
    if any(r[0] for r in results):
        log("closed: " + "; ".join(r[1] for r in results))
    return ok, "; ".join(r[1] for r in results)


# --- text snapshot ---

def once():
    sampler = Sampler()
    sampler.sample()
    time.sleep(1)
    s = sampler.sample()
    mem = s["mem"]
    busy = sum(s["cores"]) / len(s["cores"]) if s["cores"] else 0
    print(f"{s['chip'].replace('Apple ', '')}  {len(s['cores'])} cores, CPU {busy:.0%} busy, load {s['load'][0]:.1f}")
    print(f"memory {mem['used'] / GB:.1f} of {mem['total'] / GB:.0f} GB in use, swap {mem['swap'] / GB:.1f} GB, "
          f"{mem['level']}% free")
    ss = sorted(s["sessions"], key=lambda x: -x["cpu"])
    print(f"\n{len(ss)} Claude Code session(s):")
    print(f"  {'session':9}{'name':44} {'state':9}{'CPU':>5}{'RAM':>9}{'idle':>6}")
    for x in ss:
        print(f"  {x['sid'][:8]:9}{short(x['name'] or '(unnamed)', 42):44} {x['status']:9}{cores(x['cpu']):>5}"
              f"{gb(x['rss']):>9}{ago(x['idle']):>6}")
    items = cleanup(s)
    print("\nIdle, nobody using it:" if items else "\nIdle, nobody using it: nothing")
    for i in items:
        print(f"  {i['kind']:9}{short(i['label'], 44):45} {i['detail']} · {i['note']}")


# --- doctor ---

def doctor():
    ok = True

    def check(name, good, detail="", required=True):
        nonlocal ok
        if required:
            ok = ok and good
        tag = "ok  " if good else ("FAIL" if required else "--  ")
        print(f"  [{tag}] {name}" + (f" - {detail}" if detail else ""))

    print("claude-pool doctor\n")
    check("macOS", sys.platform == "darwin", sys.platform)
    check("Python 3.8+", sys.version_info >= (3, 8), sys.version.split()[0])
    check("Claude Code CLI", bool(sh(ENVLINE + f"{CLAUDE} --version 2>/dev/null").strip()), CLAUDE)
    try:
        Cores().usage()
        check("per-core CPU counters", True)
    except Exception as e:
        check("per-core CPU counters", False, repr(e))
    try:
        n = len(Sampler().sample()["sessions"])
        check("can list Claude sessions", True, f"{n} running now")
    except Exception as e:
        check("can list Claude sessions", False, repr(e))
    app = Path(HOME, "Applications/ClaudePool.app")
    check("menu bar app installed (optional)", app.exists(),
          str(app) if app.exists() else "not installed - run menubar/build.sh to add it", required=False)
    print("\nAll good - run `claude-pool` for the monitor." if ok else "\nSome checks failed; see above.")
    sys.exit(0 if ok else 1)


# --- agent for the menu bar ---

def menu_state(s):
    busy = sum(s["cores"]) / len(s["cores"]) if s["cores"] else 0
    mem = s["mem"]
    items = cleanup(s)
    sessions = [{"text": f"{short(x['name'] or x['sid'][:8], 46)}   {x['status']} · {cores(x['cpu'])} cores · {gb(x['rss'])}"}
                for x in sorted(s["sessions"], key=lambda x: -x["cpu"])]
    idle = [{"text": f"Close “{short(i['label'], 44)}”", "detail": f"{i['detail']} · {i['note']}",
             "args": (["--close", i["spec"]] if i["closable"] else None), "key": i["key"]} for i in items]
    return {"title": {"pct": round(busy * 100), "mem": round(mem["used"] / mem["total"] * 100),
                      "hot": busy >= 0.85 or mem["level"] < 20, "idle": sum(1 for i in items if i["closable"])},
            "summary": f"CPU {busy:.0%} busy · RAM {mem['used'] / GB:.1f} of {mem['total'] / GB:.0f} GB · "
                       f"{len(s['sessions'])} sessions",
            "sessions": sessions, "idle": idle,
            "closeAll": ["--close"] + [i["spec"] for i in items if i["closable"]]}


def agent(interval=2.0):
    sampler = Sampler()
    sampler.sample()
    while True:
        time.sleep(interval)
        try:
            print(json.dumps(menu_state(sampler.sample())), flush=True)
        except BrokenPipeError:
            return
        if os.getppid() == 1:
            return


def main():
    for k in [k for k in os.environ if k.startswith("CLAUDE")]:
        del os.environ[k]
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd in ("-v", "--version"):
        print("claude-pool " + VERSION)
    elif cmd == "doctor":
        doctor()
    elif cmd == "--once":
        once()
    elif cmd == "--agent":
        agent(float(args[1]) if len(args) > 1 else 2.0)
    elif cmd == "--close" and len(args) >= 2:
        okk, msg = close(args[1:])
        print(msg)
        sys.exit(0 if okk else 1)
    elif not cmd:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import monitor_tui
        monitor_tui.run(Sampler, cleanup, close)
    else:
        sys.exit(f"claude-pool: unknown arguments {' '.join(args)!r}; see --help")


if __name__ == "__main__":
    main()
