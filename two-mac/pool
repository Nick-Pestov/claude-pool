# --- service, which runs on the old Mac around the clock ---

def on_old(script, timeout=60):
    """Run script on the old Mac (here, or over ssh from the M5). Return (status, output)."""
    if SELF == OLD:
        p = subprocess.run(["bash", "-c", PREAMBLE + script], capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout + p.stderr
    return peer(script + " 2>&1", timeout=timeout)


def service(args):
    """`pool service [logs|restart]`. The always-on service's launchd agent lives in the stay Mac's login session
    (gui domain), where sessions it starts can read the keychain, so a restart never goes through an ssh session.
    Configure it with "always_on": {"label": ..., "state": ..., "name": ..., "log": ...} in pool.json."""
    if not SERVICE_LABEL:
        die('no always-on service is configured (set "always_on" in ~/.config/pool/pool.json)')
    what = args[0] if args else "status"
    svc = f"gui/$(id -u)/{SERVICE_LABEL}"
    log_file = (CONF["always_on"] or {}).get("log")
    if what == "status":
        tail = (f"echo 'recent log:'; tail -n 5 {q(log_file)} | cut -c1-160 | sed 's/^/  /'") if log_file else "true"
        status, out = on_old(
            f"pid=$(launchctl print {svc} 2>/dev/null | awk '/^\tpid = / {{print $3}}'); "
            f"state=$(launchctl print {svc} 2>/dev/null | awk '/^\tstate = / {{print $3; exit}}'); "
            "echo \"service: ${state:-not loaded}${pid:+ (pid $pid, up $(ps -o etime= -p $pid | tr -d ' '))}\"; " + tail)
        print(out.rstrip() if out else f"pool: can't reach {NAMES[OLD]}")
        return status
    if what == "logs":
        if not log_file:
            die('no log path configured (add "log" to "always_on" in pool.json)')
        if "-f" in args:
            return subprocess.run(["ssh", "-t", ALIAS[OLD], f"tail -n 40 -f {q(log_file)}"] if SELF != OLD
                                  else ["bash", "-c", f"tail -n 40 -f {q(log_file)}"]).returncode
        status, out = on_old(f"tail -n 40 {q(log_file)}")
        print(out.rstrip())
        return status
    if what == "restart":
        status, out = on_old(f"launchctl kickstart -k {svc} && sleep 3 && "
                             f"launchctl print {svc} | awk '/^\tstate = / {{print \"service: \" $3; exit}}'")
        print(out.rstrip())
        return status
    die(f"unknown service command {what!r}; try `pool service`, `pool service logs [-f]`, or `pool service restart`")


# --- sync conflicts ---

def index_checkout(path):
    """The checkout a git index file belongs to, or None if path isn't one."""
    repo, sep, inner = path.partition("/.git/")
    if not sep:
        return None
    if inner == "index":
        return repo
    m = re.fullmatch(r"worktrees/([^/]+)/index", inner)
    if not m:
        return None
    try:
        return os.path.dirname(Path(repo, ".git/worktrees", m.group(1), "gitdir").read_text().strip())
    except OSError:
        return None


def working_in(checkout, per_mac):
    """The one Mac with a Claude session working in checkout (not a worktree nested under it), else None."""
    hosts = set()
    for host, ss in per_mac.items():
        for _, s in ss:
            cwd = s.get("cwd") or ""
            if cwd == checkout or (cwd.startswith(checkout + "/") and not cwd.startswith(checkout + "/.claude/worktrees/")):
                hosts.add(host)
    return hosts.pop() if len(hosts) == 1 else None


def read_on(host, path):
    if host == SELF:
        return Path(path).read_bytes()
    return subprocess.run(["ssh", ALIAS[PEER], f"cat {q(path)}"], capture_output=True, check=True, timeout=60).stdout


def replace_on(host, path, data):
    """Atomically replace path's content on host (the temp file sits outside the synced folders)."""
    tmp = f"{HOME}/.local/state/pool/replace-{os.getpid()}"
    if host == SELF:
        Path(tmp).write_bytes(data)
        os.replace(tmp, path)
    else:
        subprocess.run(["ssh", ALIAS[PEER], f"mkdir -p ~/.local/state/pool && cat > {q(tmp)} && mv {q(tmp)} {q(path)}"],
                       input=data, check=True, timeout=60)


def mtime_on(host, path):
    if host == SELF:
        return os.stat(path).st_mtime
    status, out = peer(f"stat -f %m {q(path)}")
    return float(out.strip()) if status == 0 and out.strip() else 0.0


NOTIFIED = set()


def settle_conflicts(sessions):
    """Two-way sync holds a file still when both Macs changed it. Pick a winner, save the loser's copy and give it
    the winner's content, so the next sync cycle sees them equal. A git index goes to the Mac with a session
    working in that checkout (each Mac's index carries its own file timestamps, so they clash whenever both run
    git there); anything else goes to the newer copy."""
    per_mac = None
    for s in sessions:
        for c in s.get("conflicts") or []:
            path = os.path.join(s["beta"]["path"], c.get("root", ""))
            kinds = {(ch.get("new") or {}).get("kind") for ch in c.get("alphaChanges", []) + c.get("betaChanges", [])}
            if kinds != {"file"}:
                if path not in NOTIFIED:
                    NOTIFIED.add(path)
                    notify(f"Sync conflict at {os.path.relpath(path, HOME)} needs a look "
                           f"(`mutagen sync list --long {s['name']}`).")
                continue
            checkout = index_checkout(path)
            winner = None
            if checkout:
                per_mac = per_mac or all_sessions()
                winner = working_in(checkout, per_mac)
            if not winner:
                winner = SELF if mtime_on(SELF, path) >= mtime_on(PEER, path) else PEER
            loser = PEER if winner == SELF else SELF
            keep = STATE / "conflicts" / time.strftime("%Y%m%d-%H%M%S") / ("m5" if loser == M5 else "old")
            dest = keep / os.path.relpath(path, HOME)
            dest.parent.mkdir(parents=True, exist_ok=True)
            try:
                dest.write_bytes(read_on(loser, path))
                replace_on(loser, path, read_on(winner, path))
            except (OSError, subprocess.SubprocessError) as e:
                log(f"couldn't settle {path}: {e}")
                continue
            msg = (f"Both Macs changed {os.path.relpath(path, HOME)}; kept {NAMES[winner]}'s copy, "
                   f"saved {NAMES[loser]}'s in {keep}.")
            log(msg) if checkout else notify(msg)


# --- daemon ---

def daemon():
    STATE.mkdir(parents=True, exist_ok=True)
    desktop_tmux_here()
    over = {M5: 0, OLD: 0}
    last_balance = 0.0
    away = cable_seen = cycle = 0
    while True:
        cycle += 1
        try:
            # The cable gets priority: once it has answered on two passes in a row (so a loose plug doesn't bounce
            # connections), move whatever is still on Wi-Fi onto it; once it's pulled, move what was on it to Wi-Fi.
            # Here every pass, on the other Mac every minute. (PoolBar's agents react within a second; this is the
            # backstop when PoolBar isn't running.)
            plugged = cable_plugged()
            cable_seen = cable_seen + 1 if plugged and cable_peer() else 0
            if cable_seen >= 2 or not plugged:
                reroute(plugged=plugged)
                if cycle % 4 == 0:
                    peer("pool _reroute", timeout=60)
        except Exception as e:
            log(f"daemon reroute failed: {e!r}")
        try:
            # Leaving the office: a minute with the old Mac out of reach opens windows here for what runs here
            # (windows showing old-Mac sessions take those over by themselves); back in reach, its stale copies
            # stop. Unplugging the cable isn't a signal: it comes out for display rearranging too.
            loads = measure_both()
            if PEER not in loads:
                away += 1
                if away == 4:
                    go_home(f"{NAMES[PEER].capitalize()} out of reach")
            else:
                away = 0
            sessions = sync_sessions()
            d = {"loads": loads, "synced": synced_roots(sessions)}
            (STATE / "load.json").write_text(json.dumps(d))
            peer("mkdir -p ~/.local/state/pool && cat > ~/.local/state/pool/load.json", input=json.dumps(d))
            settle_conflicts(sessions)
            for h in over:
                over[h] = over[h] + 1 if h in loads and overloaded(loads[h]) else 0
            # Two minutes of overload, at most one rebalancing every five.
            if max(over.values()) * INTERVAL >= 120 and time.time() - last_balance > 300:
                last_balance = time.time()
                balance(loads)
        except Exception as e:  # keep the loop alive; the log says what broke
            log(f"daemon cycle failed: {e!r}")
        time.sleep(INTERVAL)


# --- status ---

def recent(n=8):
    """The last n lines of both Macs' pool logs (moves, commands sent across, conflicts), newest last."""
    lines = []
    for host, text in ((SELF, (STATE / "pool.log").read_text() if (STATE / "pool.log").exists() else ""),
                       (PEER, peer("tail -n 40 ~/.local/state/pool/pool.log 2>/dev/null", timeout=5)[1])):
        lines += [(l[:19], "M5" if host == M5 else "old", l[20:]) for l in text.splitlines()[-40:] if len(l) > 20]
    return sorted(lines)[-n:]


def bar(m, width=30):
    """Share of cores busy; past 100% the bar is full and the overflow is printed after it."""
    frac = busy(m)
    filled = min(width, round(frac * width))
    return "█" * filled + "·" * (width - filled) + (f" +{frac - 1:.0%}" if frac > 1 else "")


def watch(once=False):
    per_mac, sessions_at = {}, 0.0
    try:
        while True:
            loads = measure_both()
            if time.time() - sessions_at > 10:  # listing sessions takes a second or two; refresh it less often
                per_mac = all_sessions() if SELF == M5 else {SELF: local_sessions()}
                sessions_at = time.time()
            out = [f"pool · {time.strftime('%H:%M:%S')} · cores busy (█) on each Mac · Ctrl+C to quit", ""]
            for h in (M5, OLD):
                m = loads.get(h)
                if not m:
                    out.append(f"{NAMES[h]:12} unreachable")
                    continue
                ss = [s for _, s in per_mac.get(h, []) if s.get("pid")]
                working = sum(1 for s in ss if s.get("status") == "busy")
                out.append(f"{NAMES[h]:12} {bar(m):36} {busy(m):>5.0%}   load {m['load1']:>5.1f} / {m['cores']:<3}"
                           f" memory free {m['mem_free']:>3}%   sessions {len(ss)} ({working} working)")
            sessions = sync_sessions()
            bad = [s["name"] for s in sessions if not healthy(s)]
            out += ["", f"sync: {len(sessions)} folders, " + (f"needs a look: {', '.join(bad)}" if bad else "all in step"),
                    "", "recent (moves, commands sent to the other Mac, sync conflicts):"]
            out += [f"  {t[11:]} {who:>3}  {msg[:110]}" for t, who, msg in recent()] or ["  nothing yet"]
            print("\033[H\033[2J" + "\n".join(out) if not once else "\n".join(out), flush=True)
            if once:
                return
            time.sleep(2)
    except KeyboardInterrupt:
        print()


def status():
    d = cached_loads() or {"loads": measure_both(), "synced": synced_roots(sync_sessions())}
    loads = d["loads"]
    per_mac = all_sessions() if SELF == M5 else {SELF: local_sessions()}
    print(f"{'':14}{'load':>12}{'busy':>7}{'room':>7}{'mem free':>10}   sessions")
    for h in (M5, OLD):
        m = loads.get(h)
        if not m:
            print(f"{NAMES[h]:14}  unreachable")
            continue
        line = f"{NAMES[h]:14}{m['load1']:>6} / {m['cores']:<3}{busy(m):>7.0%}{room(m):>7.1f}{m['mem_free']:>9}%"
        if h in per_mac:
            ss = [s for _, s in per_mac[h] if s.get("pid")]  # entries without a process aren't running
            bg = sum(1 for s in ss if s.get("kind") == "background")
            working = sum(1 for s in ss if s.get("status") == "busy")
            line += f"   {len(ss)} ({working} working, {bg} in background)"
        print(line)
    print("room = idle capacity in old-Mac cores (an M5 core is about 1.8 of them)")
    sessions = sync_sessions()
    bad = [s for s in sessions if not healthy(s) and "-seed" not in s["name"]]
    seeding = [s["name"] for s in sessions if "-seed" in s["name"]]
    print(f"sync: {len(sessions) - len(seeding)} folders live" + (f", {len(bad)} need attention: "
          + ", ".join(f"{s['name']} ({s.get('status')})" for s in bad) if bad else ", all in step")
          + (f"; seeding {', '.join(seeding)}" if seeding else ""))


def local_sessions():
    """[(profile, session dict)] on this Mac (used when only this side's view is available)."""
    return agents_on(SELF)


def main():
    own_session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    for k in [k for k in os.environ if k.startswith("CLAUDE")]:
        del os.environ[k]
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    rest = args[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd == "status":
        status()
    elif cmd == "watch":
        watch(once="--once" in rest)
    elif cmd == "run":
        sys.exit(run(rest))
    elif cmd == "hook":
        hook()
    elif cmd == "daemon":
        daemon()
    elif cmd == "balance":
        moved = balance(dry_run="--dry-run" in rest)
        if not moved and "--dry-run" not in rest:
            print("nothing to move: neither Mac is overloaded, or no idle background session can go")
    elif cmd == "move":
        if not rest:
            die("which session? `pool` lists them")
        to = SHORT.get(rest[rest.index("--to") + 1]) if "--to" in rest else None
        sid = rest[0]
        if not to:
            found = {h for h, ss in all_sessions().items() for _, s in ss if (s.get("sessionId") or "").startswith(sid)}
            if len(found) != 1:
                die(f"session {sid} isn't running on exactly one Mac; pass --to m5 or --to old")
            to = OLD if found.pop() == M5 else M5
        sid, cwd, target = move(sid, to)
        print(f"Moved {sid[:8]} ({cwd}) to {NAMES[to]}" + (f"; attach with `claude attach {target}` on {NAMES[OLD]}" if to == OLD else
                                                            f"; attach with `claude attach {target}`"))
    elif cmd == "doctor":
        doctor()
    elif cmd == "route":
        if "--fix" in rest:
            for line in reroute(force=True) + [l for l in peer("pool _reroute --force", timeout=90)[1].splitlines() if l]:
                print("fixed:", line)
            time.sleep(8)  # let dropped connections come back before showing the routes
        route_status()
    elif cmd == "_reroute":
        for line in reroute(dry_run="--dry-run" in rest, force="--force" in rest):
            print(line)
    elif cmd == "_links":
        print(json.dumps(peer_links()))
    elif cmd == "top":
        os.execv(sys.executable, [sys.executable, HOME + "/.local/bin/pool-top", *rest])
    elif cmd == "tier":
        if not rest:
            die("which session? `pool` lists them")
        if len(rest) > 1:
            # "travel"/"stay" are clearer aliases for the internal "home"/"m1" tiers (travel Mac / stay Mac).
            tier = {"travel": "home", "stay": "m1"}.get(rest[1], rest[1])
            if tier not in TIER_NAMES + ("auto",):
                die("tier is one of home (travel Mac), stay, float, or auto")
            set_tier(rest[0], tier)
        print(f"{rest[0][:8]}: %s (%s)" % tier_of(rest[0]))
    elif cmd == "pin":
        if not rest:
            die("which session?")
        PINS.parent.mkdir(parents=True, exist_ok=True)
        with open(PINS, "a") as f:
            f.write(rest[0][:8] + "\n")
    elif cmd == "claude":
        # Start a session on the Mac with more room. If that's the other Mac, open it there over ssh in this terminal
        # (its tmux, so it can read the keychain); otherwise just start here.
        d = cached_loads()
        target = choose(d["loads"] if d else measure_both())
        if target == SELF or SELF != M5:
            os.execvp("claude", ["claude", *rest])
        note(f"starting on {NAMES[PEER]}: {NAMES[SELF]} is busy")
        if not desktop_tmux_on_peer():
            os.execvp("claude", ["claude", *rest])
        cwd = os.getcwd() if peer(f"test -d {q(os.getcwd())}")[0] == 0 else HOME
        inner = PREAMBLE + f"cd {q(cwd)} && exec claude " + " ".join(q(a) for a in rest)
        sys.exit(attach_there(f"pool-sh-claude", f"exec {POOL_TMUX} new -A -s pool-claude-{os.getpid()} -c {q(cwd)} {q(inner)}"))
    elif cmd == "_measure":
        print(json.dumps(measure()))
    elif cmd == "_sync-json":
        print(json.dumps(sync_sessions()))
    elif cmd == "_flush":
        sys.exit(0 if flush(rest[0]) else 3)
    elif cmd == "tab":
        args = [a for a in rest if a != "--show"]
        show = "--show" in rest   # a move the user asked for: bring Ghostty forward so the reconnect is visible
        if not args:
            tab(own_session)
        elif tab_move(args[0], show=show) or peer(f"pool _tab-move {q(args[0])}{' --show' if show else ''}")[0] == 0:
            print(f"pool: moving session {args[0]}'s tab to the other Mac; its window stays and reconnects")
        else:
            die(f"session {args[0]} isn't open in a Ghostty tab on either Mac")
    elif cmd == "_tab-there":
        tab_there(int(rest[0]), rest[1], rest[2], rest[3], float(rest[4]) if len(rest) > 4 else 0,
                  show=len(rest) > 5 and rest[5] == "1")
    elif cmd == "_tab-move":
        sys.exit(0 if tab_move([a for a in rest if a != "--show"][0], show="--show" in rest) else 1)
    elif cmd == "_tab-candidates":
        print(json.dumps(tab_candidates()))
    elif cmd == "_tab-back":
        tab_back(int(rest[0]), rest[1], rest[2], rest[3])
    elif cmd == "_remote-claude":
        remote_claude(rest[0], rest[1])
    elif cmd == "_type":
        sys.exit(0 if type_into(rest[0], rest[1]) else 1)
    elif cmd == "home":
        print(go_home("pool home"))
    elif cmd == "service":
        sys.exit(service(rest))
    elif cmd == "_settle":
        settle_conflicts(sync_sessions())
    else:
        die(f"unknown command {cmd!r}; see `pool --help`")


if __name__ == "__main__":
    main()
