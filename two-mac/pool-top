BRAILLE = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))  # dot bits by [row within the cell][column]
BLOCKS = "▁▂▃▄▅▆▇█"
SHADES = "░▒▓█"


def buckets(hist, now, span, n, value, gap):
    """value(entry) averaged over each of n equal slices of the last span seconds. An empty slice carries the previous
    value on across gaps shorter than gap seconds, else is None (a gap in the line)."""
    sums, counts = [0.0] * n, [0] * n
    start = now - span
    for e in hist:
        if start <= e[0] <= now:
            i = min(n - 1, int((e[0] - start) / span * n))
            sums[i] += value(e)
            counts[i] += 1
    out, last, last_i = [], None, -1
    for i in range(n):
        if counts[i]:
            last, last_i = sums[i] / counts[i], i
            out.append(last)
        elif last is not None and (i - last_i) * span / n <= gap:
            out.append(last)
        else:
            out.append(None)
    return out


def smooth(values, k):
    """Centred moving average over k columns (gaps stay gaps), so second-to-second noise doesn't hide the trend."""
    if k <= 1:
        return values
    half, out = k // 2, []
    for i, v in enumerate(values):
        near = [p for p in values[max(0, i - half): i + half + 1] if p is not None]
        out.append(sum(near) / len(near) if v is not None and near else None)
    return out


def plot(series, w, h, top=1.0):
    """A braille line chart: series is [(values for 2*w dot columns, colour)]. Returns (dot bits, colour) per cell;
    a cell two series share gets "mixed"."""
    bits = [[0] * w for _ in range(h)]
    owner = [[None] * w for _ in range(h)]
    rows = h * 4
    for values, colour in series:
        prev = None
        for x, v in enumerate(values[: 2 * w]):
            if v is None:
                prev = None
                continue
            y = rows - 1 - max(0, min(rows - 1, int(round(v / top * (rows - 1)))))
            lo, hi = (y, y) if prev is None else (min(prev, y), max(prev, y))
            for yy in range(lo, hi + 1):  # join to the previous point so steep changes stay one line
                r, c = yy // 4, x // 2
                bits[r][c] |= BRAILLE[yy % 4][x % 2]
                owner[r][c] = colour if owner[r][c] in (None, colour) else "mixed"
            prev = y
    return bits, owner


def span_text(secs):
    return f"{secs // 60} min" if secs < 3600 else "hour"


class Monitor:
    MODES = ("cpu", "cores", "memory")
    SPANS = (120, 300, 900, 1800, 3600)
    TIER_CYCLE = ("auto", "home", "float", "m1")

    def __init__(self, scr, feed, meta):
        self.scr, self.feed, self.meta = scr, feed, meta
        self.mode, self.span = 0, 1
        self.cursor = None      # chart column the readout follows (the chart holds still meanwhile), None for live
        self.frozen = None      # (now, history) while scrubbing
        self.sel, self.top = 0, 0
        self.expand, self.help = False, False
        self.confirm = None     # the session row waiting for y
        self.msg, self.msg_at = "", 0.0
        self.rows, self.row_y = [], {}
        self.chart_box = None   # (y, x, height, width) of the plot, for clicks
        self.v = None
        self.colors()

    def colors(self):
        curses.start_color()
        try:
            curses.use_default_colors()
            bg = -1
        except curses.error:
            bg = curses.COLOR_BLACK
        many = curses.COLORS >= 256
        n = [0]

        def pair(fg, fallback):
            n[0] += 1
            curses.init_pair(n[0], fg if many else fallback, bg)
            return curses.color_pair(n[0])

        self.c = {M5: pair(68, curses.COLOR_BLUE), OLD: pair(166, curses.COLOR_YELLOW),
                  "muted": pair(245, curses.COLOR_WHITE), "faint": pair(238, curses.COLOR_WHITE),
                  "ok": pair(71, curses.COLOR_GREEN), "warn": pair(178, curses.COLOR_YELLOW),
                  "bad": pair(167, curses.COLOR_RED), "mixed": pair(252, curses.COLOR_WHITE)}
        # one hue each, dark to bright, for the per-core heat map
        self.ramp = {M5: [pair(c, curses.COLOR_BLUE) for c in (24, 31, 38, 81)],
                     OLD: [pair(c, curses.COLOR_YELLOW) for c in (94, 130, 166, 214)]}
        if not many:
            self.c["faint"] |= curses.A_DIM
            self.c["muted"] |= curses.A_DIM

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return x
        text = text[: max(0, w - x - (1 if y == h - 1 else 0))]
        try:
            self.scr.addstr(y, x, text, attr)
        except curses.error:
            pass
        return x + len(text)

    def say(self, msg):
        self.msg, self.msg_at = msg, time.time()

    # drawing

    def draw(self):
        v = self.v = view(self.feed, self.meta)
        scr = self.scr
        scr.erase()
        H, W = scr.getmaxyx()
        if H < 16 or W < 60:
            self.put(0, 0, "pool top needs at least 60x16; make the window bigger")
            scr.refresh()
            return
        if self.help:
            self.draw_help(H, W)
            scr.refresh()
            return
        y = self.draw_title(v, W)
        for h in (M5, OLD):
            y = self.draw_mac(y, v, h)
        rows = self.rows = self.table_rows(v)
        snoozes = snoozed()
        self.idle = [i for i in v["cleanup"] if snoozes.get(i["key"], 0) <= time.time()]
        more = len(self.idle) - 3
        notes = (v["recs"] + v["dups"]
                 + (["service isn't running on the M1 (B restarts it)"] if v.get("service") is False else [])
                 + ([{"info": v["imbalance"]}] if v.get("imbalance") else []) + self.idle[:3]
                 + ([{"info": f"…and {more} more idle things holding {gb(sum(i['rss'] for i in self.idle[3:]))}; "
                              "X closes everything listed as idle"}] if more > 0 else [])) or [None]
        n_notes = min(len(notes), max(1, (H - y) // 8))
        avail = H - y - (1 + 1 + n_notes + 3)        # gap, notes header, notes; detail, apps, footer
        table = min(len(rows), 14) + 1
        chart = max(8, min(avail - table, 34))
        if self.MODES[self.mode] == "cores":
            chart = max(chart, min(avail - 4, sum(s["ncpu"] for s in v["latest"].values()) + 5))
        y = self.draw_chart(y, chart, W, v)
        y = self.draw_notes(y, W, v, notes[:n_notes])
        y = self.draw_table(y, H - y - 3, W, v, rows)
        self.draw_detail(H - 3, W, v)
        self.draw_apps(H - 2, W, v)
        self.draw_footer(H - 1, W)
        scr.refresh()

    def draw_title(self, v, W):
        x = self.put(0, 0, " pool top", curses.A_BOLD)
        x = self.put(0, x, f" · M5 + M1 · {time.strftime('%H:%M:%S')}", self.c["muted"])
        if self.feed.peer_note:
            self.put(0, x + 2, self.feed.peer_note, self.c["warn"])
        elif v.get("link"):
            state = v["link"]["state"]
            x = self.put(0, x + 3, "● ", self.c[{"cable": "ok", "moving": "warn", "wifi": "muted"}[state]])
            self.put(0, x, {"cable": "linked by cable", "moving": "cable plugged in, moving off Wi-Fi",
                            "wifi": "linked over Wi-Fi"}[state], self.c["muted"])
        right = "? help · q quit"
        self.put(0, W - len(right) - 1, right, self.c["muted"])
        return 2

    def bar(self, y, x, frac, width, colour, mark=None):
        filled = max(0, min(width, int(round(frac * width))))
        at = int(round(mark * width)) if mark is not None else -1
        for i in range(width):
            if i == at:
                x = self.put(y, x, "┃", self.c["warn"] if frac >= mark else self.c["muted"])
            else:
                x = self.put(y, x, "█" if i < filled else "░", colour if i < filled else self.c["faint"])
        return x

    def draw_mac(self, y, v, h):
        s, m = v["latest"].get(h), v["macs"].get(h)
        x = self.put(y, 1, "●", self.c[h])
        x = self.put(y, x + 1, LABEL[h], self.c[h] | curses.A_BOLD)
        if not s:
            self.put(y, x + 2, "out of reach" if h == PEER and self.feed.peer_note else "starting…", self.c["muted"])
            return y + 3
        x = self.put(y, x + 1, f" {s['chip'].replace('Apple ', ''):<7}", self.c["muted"])
        x = self.put(y, x + 1, "CPU ", self.c["muted"])
        x = self.bar(y, x, m["util_now"], 24, self.c[h], CEILING[h])
        x = self.put(y, x, f" {m['util_now']:>4.0%}", curses.A_BOLD)
        x = self.put(y, x, f" of capacity · {room(dict(m, util=m['util_now']), h):.1f} to spare of {m['capacity']:.1f}"
                           f" · load {s['load'][0]:.1f}", self.c["muted"])
        service = service_load(v, h)
        if service:
            self.put(y, x, f" · service + its sessions {cores(service[0])} cores, {gb(service[1])}", self.c["muted"])
        y += 1
        x, last = 4, None
        for name, idx in s["clusters"]:  # fastest cores first, a space between clusters
            if name != last:
                x = self.put(y, x, f"{name} ", self.c["muted"])
                last = name
            for i in idx:
                c = s["cores"][i]
                x = self.put(y, x, BLOCKS[min(7, int(c * 8))] if c >= 0.03 else "▁", self.c[h] if c >= 0.03 else self.c["faint"])
            x += 1
        x = max(x + 1, 46)
        x = self.put(y, x, "RAM ", self.c["muted"])
        x = self.bar(y, x, m["used"] / m["total"], 16, self.c[h])
        x = self.put(y, x, f" {m['used'] / GB:.1f}/{m['total'] / GB:.0f} GB", curses.A_BOLD)
        x = self.put(y, x, f" · swap {m['swap'] / GB:.1f} GB · ", self.c["muted"])
        state, colour = (("memory ok", "ok") if m["level"] >= MEM_TIGHT else ("memory tight", "warn")
                         if m["level"] >= MEM_LOW else ("memory low", "bad"))
        x = self.put(y, x, "● ", self.c[colour])
        self.put(y, x, f"{state} ({m['level']}% free)", self.c["muted"])
        return y + 2

    def draw_chart(self, y, height, W, v):
        mode = self.MODES[self.mode]
        span = self.SPANS[self.span]
        titles = {"cpu": "CPU, share of each Mac's capacity", "cores": "Each core, busy share",
                  "memory": "Memory in use, share of RAM"}
        x = self.put(y, 1, titles[mode], curses.A_BOLD)
        self.put(y, x, f" · last {span_text(span)} · g next graph · +/- span · ←/→ or click to look back", self.c["muted"])
        if mode != "cores":
            lx = W - 14
            for h in (M5, OLD):
                lx = self.put(y, lx, "● ", self.c[h])
                lx = self.put(y, lx, LABEL[h] + "  ", self.c["muted"])
        if self.frozen:
            now, hist = self.frozen
        else:
            now, hist = time.time(), {h: self.feed.history(h) for h in (M5, OLD)}
        left, pw = 7, W - 9
        ph = height - 3
        top = y + 1
        self.chart_box = (top, left, ph, pw)
        gap = 3 * self.feed.interval + 1
        readout = []
        if mode in ("cpu", "memory"):
            idx = 2 if mode == "cpu" else 3
            k = int(round(5 / (span / (pw * 2))))  # about 5 s of samples per point
            series = [(smooth(buckets(hist[h], now, span, pw * 2, lambda e: e[idx], gap), k), h) for h in (M5, OLD)]
            bits, owner = plot(series, pw, ph)
            dots = ph * 4 - 1
            guides = {}
            if mode == "cpu":  # the row each Mac's ceiling falls in, as plot() places values
                for h in (M5, OLD):
                    guides[(dots - int(round(CEILING[h] * dots))) // 4] = h
            for r in range(ph):
                if r in (0, ph - 1) or r == (ph - 1) // 2:
                    frac = 1 - min(dots, r * 4 + (0 if r == 0 else 3 if r == ph - 1 else 1.5)) / dots
                    self.put(top + r, 0, f"{frac:>5.0%} ", self.c["muted"])
                self.put(top + r, left - 1, "┤" if r in (0, ph - 1, (ph - 1) // 2) else "│", self.c["faint"])
                for c in range(pw):
                    ch, attr = (chr(0x2800 + bits[r][c]), self.c[owner[r][c]]) if bits[r][c] else \
                        (("┄", self.c["faint"]) if r in guides else (" ", 0))
                    if c == self.cursor:
                        attr |= curses.A_REVERSE
                    self.put(top + r, left + c, ch, attr)
                if r in guides:  # in the margin, so the newest data at the right edge stays visible
                    self.put(top + r, 0, f"{LABEL[guides[r]]}{CEILING[guides[r]]:>4.0%}", self.c["muted"])
            col = self.cursor if self.cursor is not None else pw - 1
            for vals, h in series:
                pts = [p for p in vals[col * 2: col * 2 + 2] if p is not None]
                readout.append((h, f"{sum(pts) / len(pts):.0%}" if pts else "no data"))
        else:
            self.draw_heat(top, left, ph, pw, hist, now, span, gap)
            col = self.cursor if self.cursor is not None else pw - 1
            for h in (M5, OLD):
                vals = buckets(hist[h], now, span, pw, lambda e: sum(e[1]) / max(1, len(e[1])), gap)
                readout.append((h, f"{vals[col]:.0%} average" if vals and vals[col] is not None else "no data"))
        axis = top + ph
        self.put(axis, left, "└" + "─" * (pw - 1), self.c["faint"])
        label_l = f"-{span_text(span)}"
        mid = f"-{span // 120} min" if span >= 240 else f"-{span // 2} s"
        self.put(axis + 1, left, label_l, self.c["muted"])
        self.put(axis + 1, left + pw // 2 - len(mid) // 2, mid, self.c["muted"])
        self.put(axis + 1, left + pw - 3, "now", self.c["muted"])
        col = self.cursor if self.cursor is not None else pw - 1
        when = now - span + (col + 0.5) * span / pw
        x = self.put(axis + 2, left, ("at " if self.cursor is not None else "now ") + time.strftime("%H:%M:%S", time.localtime(when)),
                     curses.A_BOLD if self.cursor is not None else self.c["muted"])
        for h, text in readout:
            x = self.put(axis + 2, x + 3, "● ", self.c[h])
            x = self.put(axis + 2, x, f"{LABEL[h]} {text}")
        if self.cursor is not None:
            self.put(axis + 2, x + 3, "(paused while you look back; esc for live)", self.c["muted"])
        return axis + 3

    def draw_heat(self, top, left, ph, pw, hist, now, span, gap):
        """One row per core (or per cluster, or per Mac, whatever fits), one hue per Mac, darker to brighter and
        ░▒▓█ as the core gets busier."""
        rows = []
        for h in (M5, OLD):
            s = self.v["latest"].get(h)
            if not s:
                continue
            clusters_of = collections.Counter(name for name, _ in s["clusters"])
            cores_seen, clusters_seen = collections.Counter(), collections.Counter()
            per_core, per_cluster = [], []
            for name, idx in s["clusters"]:  # rows "S0".."S5", or "Perf1", "Perf2" when there's less room
                per_core += [(f"{name[0]}{cores_seen[name] + j}", [i]) for j, i in enumerate(idx)]
                cores_seen[name] += len(idx)
                clusters_seen[name] += 1
                per_cluster.append((name[:4] + (str(clusters_seen[name]) if clusters_of[name] > 1 else ""), idx))
            rows.append((h, per_core, per_cluster))
        need = sum(len(pc) + 1 for _, pc, _ in rows)
        r = 0
        for h, per_core, per_cluster in rows:
            if need <= ph:
                lines = per_core
            elif sum(len(c) + 1 for _, _, c in rows) <= ph:
                lines = per_cluster
            else:
                lines = [("all", [i for _, idx in per_cluster for i in idx])]
            self.put(top + r, 0, f" {LABEL[h]}", self.c[h] | curses.A_BOLD)
            r += 1
            for name, idx in lines:
                if r >= ph:
                    return
                vals = buckets(hist[h], now, span, pw, lambda e, idx=idx: sum(e[1][i] for i in idx) / len(idx), gap)
                self.put(top + r, 1, f"{name:>5}", self.c["muted"])
                for c, val in enumerate(vals):
                    if val is None or val < 0.05:
                        ch, attr = ("·" if val is not None else " "), self.c["faint"]
                    else:
                        lvl = min(3, int(val * 4))
                        ch, attr = SHADES[lvl], self.ramp[h][lvl]
                    if c == self.cursor:
                        attr |= curses.A_REVERSE
                    self.put(top + r, left + c, ch, attr)
                r += 1

    def draw_notes(self, y, W, v, notes):
        x = self.put(y, 1, "Suggested moves and cleanup", curses.A_BOLD)
        self.put(y, x, " · m moves the selected session, x closes it, X closes all idle · PoolBar pops these up",
                 self.c["muted"])
        y += 1
        for n in notes:
            if n is None:
                self.put(y, 3, "none: both Macs are within their limits, every session is where its tier puts it, and "
                               "nothing has sat idle a day", self.c["muted"])
            elif isinstance(n, str):
                x = self.put(y, 2, "!! ", self.c["bad"])
                self.put(y, x, n)
            elif "info" in n:
                x = self.put(y, 2, "i  ", self.c["muted"])
                self.put(y, x, n["info"], self.c["muted"])
            elif "spec" in n:
                x = self.put(y, 2, "✕ ", self.c["muted"])
                x = self.put(y, x, f"{short(n['label'], 36):<36} ")
                x = self.put(y, x, LABEL[n["host"]], self.c[n["host"]])
                self.put(y, x + 2, f"{n['detail']} · {n['note']}", self.c["muted"])
            else:
                mark, colour = (("!", "warn") if n["level"] == 0 else ("▲", "warn") if n["level"] == 1 else ("·", "muted"))
                x = self.put(y, 2, mark + " ", self.c[colour])
                x = self.put(y, x, f"{short(n['name'] or n['sid'][:8], 36):<36} ")
                x = self.put(y, x, LABEL[n["src"]], self.c[n["src"]])
                x = self.put(y, x, " → ", self.c["muted"])
                x = self.put(y, x, LABEL[n["dst"]] + " ", self.c[n["dst"]] | curses.A_BOLD)
                self.put(y, x + 1, n["why"] + (" (once its turn ends)" if n["busy"] else ""), self.c["muted"])
            y += 1
        return y

    def table_rows(self, v):
        rows = []
        for h in (M5, OLD):
            mine = [s for s in v["sessions"] if s["host"] == h]
            pinned = [s for s in mine if s["pinned"]]
            rows += sorted((s for s in mine if not s["pinned"]), key=lambda s: (s["status"] != "busy", -s["units"]))
            if pinned and self.expand:
                rows += sorted(pinned, key=lambda s: (s["status"] != "busy", -s["units"]))
            elif pinned:
                rows.append({"group": True, "host": h, "items": pinned, "sid": f"group-{h}"})
        return rows

    def draw_table(self, y, height, W, v, rows):
        name_w = max(16, W - 78)
        head = f"   Mac session  {'name':<{name_w}} tier   state     CPU    RAM  idle  window     move"
        self.put(y, 0, head, self.c["muted"] | curses.A_UNDERLINE)
        y += 1
        height = max(1, height - 1)
        self.sel = max(0, min(self.sel, len(rows) - 1))
        if self.sel < self.top:
            self.top = self.sel
        if self.sel >= self.top + height:
            self.top = self.sel - height + 1
        recs = {r["sid"]: r for r in v["recs"]}
        self.row_y = {}
        for i, s in enumerate(rows[self.top: self.top + height]):
            n = self.top + i
            self.row_y[y] = n
            sel = curses.A_REVERSE if n == self.sel else 0
            suggested = not s.get("group") and s.get("sid") in recs   # a move is suggested for this session
            self.put(y, 0, " " * (W - 1), sel)
            # a ⇄ marker in the destination Mac's colour flags the session that would move
            mark = "›" if n == self.sel else ("⇄" if suggested else " ")
            mark_attr = sel if n == self.sel else (self.c[recs[s["sid"]]["dst"]] | curses.A_BOLD if suggested else 0)
            x = self.put(y, 1, mark, mark_attr)
            x = self.put(y, x + 1, f"{LABEL[s['host']]:<3}", self.c[s["host"]] | sel)
            if s.get("group"):
                items = s["items"]
                busy = sum(1 for it in items if it["status"] == "busy")
                text = f"service + pinned work: {len(items)} sessions pinned to the M1 ({busy} working) · b lists them"
                x = self.put(y, x + 1, f"{'':8} {short(text, name_w):<{name_w}} ", sel)
                x = self.put(y, x, f"{'m1':<6} {'':9}", self.c["muted"] | sel)
                self.put(y, x, f"{cores(sum(it['cpu5'] for it in items)):>5} {gb(sum(it['rss'] for it in items)):>7}", sel)
                y += 1
                continue
            x = self.put(y, x + 1, s["sid"][:8], self.c["muted"] | sel)
            x = self.put(y, x + 1, f"{short(s['name'] or '(unnamed)', name_w):<{name_w}} ", sel | (curses.A_BOLD if suggested else 0))
            x = self.put(y, x, f"{s['tier']:<6} ", (self.c["muted"] if s["auto"] else curses.A_BOLD) | sel)
            state_attr = {"busy": curses.A_BOLD, "waiting": self.c["warn"]}.get(s["status"], self.c["muted"])
            x = self.put(y, x, f"{s['status']:<8} ", state_attr | sel)
            x = self.put(y, x, f"{cores(s['cpu5']):>5} {gb(s['rss']):>7} {ago(s['idle']):>5}  ", sel)
            x = self.put(y, x, f"{s['window']:<10} ", self.c["muted"] | sel)
            r = recs.get(s["sid"])
            if r:
                self.put(y, x, f"→ {LABEL[r['dst']]}", self.c["warn"] | curses.A_BOLD | sel)
            y += 1
        return y

    def selected(self):
        return self.rows[self.sel] if self.rows and 0 <= self.sel < len(self.rows) else None

    def draw_detail(self, y, W, v):
        s = self.selected()
        if not s:
            return
        if s.get("group"):
            self.put(y, 1, "the service's sessions and pinned work stay on the M1 (their data lives there); b lists them",
                     self.c["muted"])
            return
        where = {"tab": f"its Ghostty tab is on the {LABEL[s['host']]}",
                 "moved": f"runs on the {LABEL[s['host']]} for a window on the {LABEL[OTHER[s['host']]]}",
                 "bg": "a background session", "tmux": "in a tmux session pool can't move",
                 "ssh": "over ssh, which pool can't move", "other": "not in a Ghostty tab, so pool can't move it"}[s["where"]]
        tier = f"{s['tier']} ({s['why']})"
        text = (f"{s['sid'][:8]} · {tier} · {where} · {s['cwd'].replace(HOME, '~')}")
        x = self.put(y, 1, short(text, W - 40), self.c["muted"])
        keys = "t tier" + ("" if s["pinned"] else "") + (f" · m move to the {LABEL[OTHER[s['host']]]}" if s["movable"] and not s["pinned"] else "")
        self.put(y, max(x + 3, W - len(keys) - 2), keys, self.c["muted"])

    def draw_apps(self, y, W, v):
        x = self.put(y, 1, "Busiest outside Claude ", self.c["muted"])
        for h in (M5, OLD):
            s = v["latest"].get(h)
            if not s:
                continue
            x = self.put(y, x + 1, LABEL[h] + ":", self.c[h])
            for name, cpu, rss in s["apps"][:4]:
                x = self.put(y, x + 1, f"{short(name, 18)} {cpu:.1f}", self.c["muted"])
            x += 2

    def draw_footer(self, y, W):
        if self.confirm:
            self.put(y, 1, short(self.confirm[0] + "  y / n", W - 2), self.c["warn"] | curses.A_BOLD)
        elif self.msg and time.time() - self.msg_at < 8:
            self.put(y, 1, short(self.msg, W - 2), curses.A_BOLD)
        else:
            self.put(y, 1, "↑↓ select · t tier · m move · x close · X close idle · g graph · +/- span · ←→ look back · "
                           "b service · ? help · q quit", self.c["muted"])

    def draw_help(self, H, W):
        lines = ("Tiers" + __doc__.split("Tiers", 1)[1]).splitlines()
        keys = ["", "Keys", "  ↑ ↓ / j k / wheel   select a session          t   cycle its tier: auto, home, float, m1",
                "  m                    move it to the other Mac (its window stays; /change-computer does the same)",
                "  g                    CPU graph, per-core heat map, memory graph",
                "  + -                  2, 5, 15, 30 or 60 minutes", "  ← → / click graph    look back (holds the graph still); esc for live",
                "  x                    close the selected session (its conversation is kept)",
                "  X                    close everything listed as idle: day-old sessions, processes no session owns",
                "  B                    restart service when it's down",
                "  b                    show service's and pinned work's pinned sessions", "  q                    quit", "",
                "Session tiers marked bold are ones you set; grey ones are guesses (ticket work is home, background and",
                "day-old sessions are m1). CPU is each session's 5-minute average in cores, with everything it started;",
                "RAM includes its MCP servers and tools. Press any key to go back."]
        for i, l in enumerate((lines + keys)[: H - 1]):
            self.put(i, 1, l[: W - 2], curses.A_BOLD if l in ("Keys",) or l.startswith("Tiers") else 0)

    # input

    def key(self, k):
        if self.help:
            self.help = False
            return True
        if self.confirm:
            (_, doing, run), self.confirm = self.confirm, None
            if k in (ord("y"), ord("Y")):
                self.say(doing)
                threading.Thread(target=run, daemon=True).start()
            else:
                self.say("left it as it is")
            return True
        if k in (ord("q"), ord("Q")):
            return False
        if k == ord("?"):
            self.help = True
        elif k in (curses.KEY_DOWN, ord("j")):
            self.sel += 1
        elif k in (curses.KEY_UP, ord("k")):
            self.sel = max(0, self.sel - 1)
        elif k == curses.KEY_NPAGE:
            self.sel += 10
        elif k == curses.KEY_PPAGE:
            self.sel = max(0, self.sel - 10)
        elif k == ord("g"):
            self.mode = (self.mode + 1) % len(self.MODES)
        elif k in (ord("+"), ord("=")):
            self.span = min(len(self.SPANS) - 1, self.span + 1)
        elif k in (ord("-"), ord("_")):
            self.span = max(0, self.span - 1)
        elif k in (curses.KEY_LEFT, ord("h")):
            self.look_back(-1 if self.cursor is not None else None)
        elif k in (curses.KEY_RIGHT, ord("l")):
            if self.cursor is not None:
                self.look_back(1)
        elif k == 27:
            self.cursor, self.frozen = None, None
        elif k == ord("b"):
            self.expand = not self.expand
        elif k == ord("t"):
            self.cycle_tier()
        elif k in (ord("m"), ord("M")):
            self.ask_move()
        elif k == ord("x"):
            self.ask_close()
        elif k == ord("X"):
            self.ask_close_idle()
        elif k == ord("B") and self.v and self.v.get("service") is False:
            self.confirm = ("Restart service on the M1 (pool service restart)?", "restarting service…", self.restart_service)
        elif k == curses.KEY_MOUSE:
            self.mouse()
        return True

    def look_back(self, step):
        if not self.chart_box:
            return
        _, _, _, pw = self.chart_box
        if self.cursor is None:
            self.freeze()
            self.cursor = pw - 1
        self.cursor += step or 0
        if self.cursor >= pw:
            self.cursor, self.frozen = None, None
        else:
            self.cursor = max(0, self.cursor)

    def freeze(self):
        self.frozen = (time.time(), {h: self.feed.history(h) for h in (M5, OLD)})

    def mouse(self):
        try:
            _, x, y, _, state = curses.getmouse()
        except curses.error:
            return
        up, down = getattr(curses, "BUTTON4_PRESSED", 0x80000), getattr(curses, "BUTTON5_PRESSED", 0x200000)
        if state & up:
            self.sel = max(0, self.sel - 1)
        elif state & down:
            self.sel += 1
        elif self.chart_box and self.chart_box[0] <= y < self.chart_box[0] + self.chart_box[2] \
                and self.chart_box[1] <= x < self.chart_box[1] + self.chart_box[3]:
            if self.cursor is None:
                self.freeze()
            self.cursor = x - self.chart_box[1]
        elif y in self.row_y:
            self.sel = self.row_y[y]

    def cycle_tier(self):
        s = self.selected()
        if not s or s.get("group"):
            return
        if s["pinned"]:
            self.say("the service's sessions and pinned work are pinned to the M1")
            return
        cur = self.meta.chosen.get(s["sid"][:8], "auto")
        nxt = self.TIER_CYCLE[(self.TIER_CYCLE.index(cur) + 1) % len(self.TIER_CYCLE)]
        threading.Thread(target=self.meta.set_tier, args=(s["sid"], nxt), daemon=True).start()
        self.meta.chosen = {**{k: t for k, t in self.meta.chosen.items() if k != s["sid"][:8]},
                            **({s["sid"][:8]: nxt} if nxt != "auto" else {})}
        self.say(f"{s['sid'][:8]}: tier " + (nxt if nxt != "auto" else "auto (pool guesses)"))

    def ask_move(self):
        s = self.selected()
        if not s or s.get("group"):
            return
        if s["pinned"]:
            self.say("the service's sessions and pinned work stay on the M1")
        elif not s["movable"]:
            self.say("pool can't move this one: " + ("it's running twice; close one copy first" if s["where"] in MOVABLE
                                                      else "it isn't in a Ghostty tab or the background"))
        else:
            text = (f"Move {s['sid'][:8]} “{short(s['name'], 40)}” to the {LABEL[OTHER[s['host']]]}? Its window stays and "
                    "reconnects; the conversation resumes there" + (", cutting off the turn it's on" if s["status"] == "busy" else "") + ".")
            self.confirm = (text, f"moving {s['sid'][:8]} to the {LABEL[OTHER[s['host']]]}…", lambda: self.move(s))

    def move(self, s):
        ok, msg = do_move(s["sid"], s["where"], OTHER[s["host"]])
        self.say(("" if ok else "couldn't move it: ") + msg.replace("pool: ", ""))

    def ask_close(self):
        s = self.selected()
        if not s or s.get("group"):
            return
        spec = "|".join([SHORT[s["host"]], "session", s["sid"], str(s["pid"]), s.get("profile") or "claude", s["kind"],
                         s.get("id") or ""])
        text = (f"Close {s['sid'][:8]} “{short(s['name'], 40)}” on the {LABEL[s['host']]}? Its conversation is kept"
                + (", but it's mid-turn" if s["status"] == "busy" else "") + ".")
        self.confirm = (text, f"closing {s['sid'][:8]}…", lambda: self.close([spec]))

    def ask_close_idle(self):
        idle = getattr(self, "idle", [])
        if not idle:
            self.say("nothing has sat idle a day, and no process is left without its session")
            return
        text = (f"Close {len(idle)} idle things holding {gb(sum(i['rss'] for i in idle))} "
                f"({', '.join(short(i['label'], 20) for i in idle[:3])}{'…' if len(idle) > 3 else ''})? "
                "Conversations are kept; service's own processes are never closed.")
        specs = [i["spec"] for i in idle]
        self.confirm = (text, f"closing {len(idle)} idle things…", lambda: self.close(specs))

    def close(self, specs):
        ok, msg = close(specs)
        self.say(("" if ok else "some didn't close: ") + msg)

    def restart_service(self):
        p = subprocess.run([sys.executable, POOL, "service", "restart"], capture_output=True, text=True)
        self.say((p.stdout + p.stderr).strip().splitlines()[-1] if (p.stdout + p.stderr).strip() else "restarted service")

    def run(self):
        curses.curs_set(0)
        self.scr.keypad(True)
        self.scr.timeout(200)
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(0)
        last = 0.0
        while True:
            if time.time() - last >= 1:
                self.draw()
                last = time.time()
            k = self.scr.getch()
            if k == -1:
                continue
            if k == curses.KEY_RESIZE:
                last = 0
                continue
            if not self.key(k):
                return
            self.draw()
            last = time.time()


def monitor():
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    if not os.environ.get("SSH_CONNECTION") and not os.environ.get("POOL_TOP_NO_TMUX"):
        pool.desktop_tmux_here()
    feed, meta = Feed(1), Meta()
    try:
        curses.wrapper(lambda scr: Monitor(scr, feed, meta).run())
    except KeyboardInterrupt:
        pass


def open_window():
    ws = pool.workspace()
    ws.osascript(f"tell {ws.GHOSTTY}\nnew window with configuration {{initial input:{ws.q('pool top')} & linefeed}}\nend tell")


def main():
    for k in [k for k in os.environ if k.startswith("CLAUDE")]:
        del os.environ[k]
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd == "--stream":
        stream(float(args[1]) if len(args) > 1 else 1.0)
    elif cmd == "--agent":
        agent(float(args[1]) if len(args) > 1 else 2.0, int(args[2]) if len(args) > 2 else None)
    elif cmd == "--once":
        once()
    elif cmd == "--window":
        open_window()
    elif cmd == "--move" and len(args) == 4:
        ok, msg = do_move(args[1], args[2], pool.SHORT[args[3]])
        print(msg)
        sys.exit(0 if ok else 1)
    elif cmd == "--snooze" and len(args) == 3:
        snooze([args[1][:8]], float(args[2]))
    elif cmd == "--snooze-keys" and len(args) >= 3:
        snooze(args[2:], float(args[1]))
    elif cmd == "--close" and len(args) >= 2:
        ok, msg = close(args[1:])
        print(msg)
        sys.exit(0 if ok else 1)
    elif cmd == "--route-fix":
        p = subprocess.run([sys.executable, POOL, "route", "--fix"], capture_output=True, text=True)
        fixed = [l for l in p.stdout.splitlines() if l.startswith("fixed:")]
        print(f"moved {len(fixed)} kind{'s' if len(fixed) != 1 else ''} of connection to the cable" if fixed
              else "nothing to move" if "cable: up" in p.stdout else "the cable isn't answering")
        sys.exit(p.returncode)
    elif cmd == "--service-restart":
        p = subprocess.run([sys.executable, POOL, "service", "restart"], capture_output=True, text=True)
        print((p.stdout + p.stderr).strip() or "restarted service")
        sys.exit(p.returncode)
    elif cmd == "--tier" and len(args) == 3:
        pool.set_tier(args[1], args[2])
    elif not cmd:
        monitor()
    else:
        sys.exit(f"pool top: unknown arguments {' '.join(args)!r}; see `pool top --help`")


if __name__ == "__main__":
    main()
