def log(msg):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "top.log", "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")


def sh(script, timeout=30):
    try:
        return subprocess.run(["bash", "-c", script], capture_output=True, text=True, timeout=timeout).stdout
    except subprocess.TimeoutExpired:
        return ""


# --- sampling one Mac ---

class Cores:
    """Busy share of each core between calls, from the kernel's tick counters (host_processor_info, no sudo)."""

    def __init__(self):
        lib = ctypes.CDLL("/usr/lib/libSystem.dylib")
        lib.mach_host_self.restype = ctypes.c_uint
        lib.host_processor_info.argtypes = [ctypes.c_uint, ctypes.c_int, ctypes.POINTER(ctypes.c_uint),
                                            ctypes.POINTER(ctypes.POINTER(ctypes.c_int)), ctypes.POINTER(ctypes.c_uint)]
        lib.vm_deallocate.argtypes = [ctypes.c_uint, ctypes.c_size_t, ctypes.c_size_t]
        self.lib, self.host = lib, lib.mach_host_self()
        self.task = ctypes.c_uint.in_dll(lib, "mach_task_self_").value
        self.prev = self.ticks()

    def ticks(self):
        """[user, system, idle, nice] ticks so far, per core."""
        count, info, n = ctypes.c_uint(), ctypes.POINTER(ctypes.c_int)(), ctypes.c_uint()
        if self.lib.host_processor_info(self.host, 2, ctypes.byref(count), ctypes.byref(info), ctypes.byref(n)):
            return []
        out = [[info[i * 4 + j] & 0xFFFFFFFF for j in range(4)] for i in range(count.value)]
        self.lib.vm_deallocate(self.task, ctypes.cast(info, ctypes.c_void_p).value, n.value * 4)
        return out

    def usage(self):
        now = self.ticks()
        out = []
        for a, b in zip(self.prev, now):
            d = [(y - x) & 0xFFFFFFFF for x, y in zip(a, b)]  # the counters are 32 bits and wrap
            out.append(round(1 - d[2] / sum(d), 3) if sum(d) else 0.0)
        self.prev = now
        return out


def layout():
    """This Mac's chip, its cores in clusters (fastest tier first) and what each core is worth in M1 performance
    cores. The kernel numbers the slower tier's cores first."""
    n = int(pool.sysctl("hw.ncpu"))
    fast = int(pool.sysctl("hw.perflevel0.logicalcpu") or n)
    slow = n - fast
    speed, tier2 = pool.SPEED.get(SELF, (1.0, 0.5))
    clusters = []
    for level, first, size in ((0, slow, fast), (1, 0, slow)):
        name = pool.sysctl(f"hw.perflevel{level}.name") or ("fast", "slow")[level]
        per = int(pool.sysctl(f"hw.perflevel{level}.cpusperl2") or 0) or size or 1
        clusters += [[name, list(range(i, min(i + per, first + size)))] for i in range(first, first + size, per)]
    weights = [round(speed * tier2, 3)] * slow + [speed] * fast
    return {"chip": pool.sysctl("machdep.cpu.brand_string"), "ncpu": n, "clusters": clusters,
            "weights": weights, "capacity": round(sum(weights), 1)}


def memory():
    """RAM in use the way Activity Monitor counts it (app memory + wired + compressed), swap, and the share of memory
    macOS considers free (kern.memorystatus_level)."""
    vm = subprocess.run(["vm_stat"], capture_output=True, text=True).stdout
    page = re.search(r"page size of (\d+)", vm)
    page = int(page.group(1)) if page else 16384
    v = {k.strip('"'): int(n) * page for k, n in re.findall(r"^([^:\n]+):\s+(\d+)\.$", vm, re.M)}
    out = subprocess.run(["sysctl", "-n", "hw.memsize", "vm.swapusage", "kern.memorystatus_level"],
                         capture_output=True, text=True).stdout.splitlines() + ["", "", ""]
    swap = re.search(r"used = ([\d.]+)M", out[1])
    app = v.get("Anonymous pages", 0) - v.get("Pages purgeable", 0)
    wired, compressed = v.get("Pages wired down", 0), v.get("Pages occupied by compressor", 0)
    return {"total": int(out[0]) if out[0].isdigit() else 1, "used": app + wired + compressed, "app": app,
            "wired": wired, "compressed": compressed, "swap": float(swap.group(1)) * MB if swap else 0.0,
            "level": int(out[2]) if out[2].strip().isdigit() else 100}


def cpu_seconds(text):
    """ps's cumulative CPU time ("12:34.56", "1-02:03:04") in seconds."""
    days, _, text = text.rpartition("-")
    secs = 0.0
    for part in text.split(":"):
        secs = secs * 60 + float(part)
    return (int(days) if days else 0) * 86400 + secs


def processes():
    """{pid: (ppid, CPU seconds so far, resident bytes, executable path, seconds since it started)}."""
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,time=,etime=,rss=,comm="], capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        f = line.split(None, 5)
        if len(f) == 6 and f[0].isdigit():
            try:
                procs[int(f[0])] = (int(f[1]), cpu_seconds(f[2]), int(f[4]) * 1024, f[5], cpu_seconds(f[3]))
            except ValueError:
                pass
    return procs


# Leftovers: processes launchd adopted because the Claude session that started them is gone. Only Claude's Bash-tool
# shells (they source a shell snapshot) and dev runtimes (servers, scripts, test browsers, MCP servers) count, and never
# anything of the service's or any pinned, pool's own, or Claude Code's own background machinery (daemon, spares, pty hosts),
# which service needs running so a request can start a session at once.
CLAUDE_SHELL = re.compile(r"shell-snapshots/snapshot-")
DEV_EXE = re.compile(r"^(node|bun|deno|python\d*(\.\d+)?|Python|pnpm|npm|npx|yarn|java|ruby|esbuild|tsx|vite|vitest|jest|"
                     r"next-server.*|uvicorn|gunicorn|pytest|chrome-headless-shell|Google Chrome for Testing|Chromium|"
                     r"chromedriver|ffmpeg|redis-server|postgres)$")
# Never offer these for closing: pool's own machinery, Mutagen, the link, and (from config) the always-on service and
# every pinned folder — so a teammate's protected work is as safe as the the service and pinned folders.
_never = [r"\.local/bin/pool", "pool-top", "mutagen", "peer-route"]
_never += [re.escape(os.path.basename(p)) for p in pool.CONF["pinned"]]
_never += [re.escape(pool.CONF["sync_root"] + "/" + os.path.basename(p)) for p in pool.CONF["pinned"]]
if pool.CONF["always_on"]:
    _never.append(re.escape(os.path.dirname(pool.CONF["always_on"]["state"])))
NEVER_CLOSE = re.compile("|".join(_never), re.I)
LEFTOVER_AGE = 600
# service's sessions wait for Slack follow-ups with a Bash-tool loop on their thread's signal file. One whose session ended
# (launchd adopted it) still takes the file's next message, so after service revives the thread with a new session, a
# follow-up can go to the dead watcher and be lost. Those are the only service processes ever offered for closing.
# A service whose sessions wait on signal files can leave an orphaned watcher when its session ends; match one by the
# service's own state directory (from config). None when no such service is configured.
_svc = pool.CONF["always_on"]
SERVICE_WATCHER = (re.compile(re.escape(os.path.dirname(_svc["state"])) + r"/signals/([\w.-]+)")
                   if _svc and _svc.get("state") else None)


def leftover(base, args, cwd):
    """Whether an adopted process (parent gone) is a Claude session's leftover that's safe to offer closing."""
    if base.startswith("claude") or NEVER_CLOSE.search(args or "") or NEVER_CLOSE.search(cwd or ""):
        return False
    if base in ("zsh", "bash", "sh"):
        return bool(CLAUDE_SHELL.search(args or ""))
    return bool(DEV_EXE.match(base))


def describe(pids, args):
    """What a leftover process tree is running, from its command lines: "node apiserver.cjs, chrome-headless-shell"."""
    names = []
    for p in pids:
        argv = (args.get(p) or "").split()
        if not argv:
            continue
        exe = os.path.basename(argv[0])
        if exe in ("zsh", "bash", "sh", "sleep", "caffeinate", "cat", "tail"):
            continue
        rest = [a for a in argv[1:] if not a.startswith("-")][:1]
        name = exe + (" " + os.path.basename(rest[0]) if rest else "")
        if name not in names:
            names.append(name)
    if not names:
        return "a shell loop left by a Claude session"
    return ", ".join(names[:3]) + (f" +{len(names) - 3} more" if len(names) > 3 else "")


def app_name(path):
    m = re.search(r"([^/]+)\.app/", path)
    return m.group(1) if m else os.path.basename(path)


def windows_showing_peer():
    """Ids of the sessions the other Mac runs that a terminal here shows (`pool _remote-claude <id>`); pgrep first,
    so this doesn't read every process's command line."""
    pids = sh("pgrep -f 'pool _remote-claude'").split()
    if not pids:
        return []
    out = sh("ps -o tty=,args= -p " + ",".join(pids))
    return [m.group(2) for m in (re.match(r"(\S+)\s+.*\bpool _remote-claude ([0-9a-f-]{36}) ", l) for l in out.splitlines())
            if m and m.group(1) not in ("??", "-")]


def hid_idle():
    """Seconds since this Mac's keyboard or pointer was last used (with Universal Control, input counts on the Mac
    the pointer is on)."""
    m = re.search(r'"HIDIdleTime" = (\d+)', sh("ioreg -c IOHIDSystem -d 4 -r -k HIDIdleTime"))
    return round(int(m.group(1)) / 1e9, 1) if m else None


class LinkWatch:
    """The link to the other Mac, kept fresh: whether the Thunderbolt cable is plugged in (asked of the driver twice a
    second), the bytes crossing it, the round trip to the other Mac on the route in use (every 3 s, and at once after a
    change) and the routes this Mac's connections take. With act (PoolBar's agent), a change also moves this Mac's
    connections: off a pulled cable at once, onto a plugged one once it has held for 2 s."""

    def __init__(self, act=False, on_change=None):
        import socket
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.act, self.on_change = act, on_change
        self.plugged = pool.cable_plugged(self.sock)
        self.cable, self.routes, self.rtt, self.rate = False, {}, None, (0.0, 0.0)
        self.lan = (0.0, None)  # (when looked up, the other Mac's address on the office network)
        self.cable_ip = None
        self.wake, self.closed, self.wrong = threading.Event(), False, 0
        threading.Thread(target=self.fast, daemon=True).start()
        threading.Thread(target=self.slow, daemon=True).start()

    def snapshot(self):
        return {"plugged": self.plugged, "cable": self.cable, "routes": dict(self.routes), "rtt": self.rtt,
                "rx": round(self.rate[0]), "tx": round(self.rate[1])}

    def fast(self):
        counters, n = None, 0
        while not self.closed:
            try:
                plugged = pool.cable_plugged(self.sock)
                if plugged != self.plugged:
                    self.plugged, self.cable, self.rtt = plugged, False, None
                    self.wake.set()
                    if self.on_change:
                        self.on_change()
                    if self.act:
                        threading.Thread(target=self.move, args=(plugged,), daemon=True).start()
                if n % 8 == 0:  # every 4 s
                    c = bridge_bytes()
                    if counters and c:
                        dt = c[0] - counters[0]
                        self.rate = (max(0, c[1] - counters[1]) / dt, max(0, c[2] - counters[2]) / dt) if dt > 0 else self.rate
                    counters = c
            except Exception as e:
                log(f"link watch failed: {e!r}")
            n += 1
            time.sleep(0.5)

    def move(self, plugged):
        if plugged:  # let the link settle and the other Mac answer on it
            time.sleep(2)
            if not self.plugged:
                return
        out = subprocess.run([sys.executable, POOL, "_reroute"], capture_output=True, text=True).stdout
        if out.strip():
            log("link change: " + out.strip().replace("\n", "; "))
        self.wake.set()

    def slow(self):
        """Every 3 s: does the other Mac answer on the cable, and the round trip. The routes (a `ps`) after a change and
        every 15 s."""
        n = 0
        while not self.closed:
            woken = self.wake.is_set()
            self.wake.clear()
            before = (self.cable, dict(self.routes))
            try:
                if woken or n % 5 == 0:  # pool's connections (your own ssh sessions are never moved, so not counted)
                    self.routes = collections.Counter(l["route"] for l in pool.peer_links() if l["kind"] != "other")
                # One ping both times the round trip and, with the cable in, shows the other Mac answers on it (its
                # address from peer-route's cache, or found again on the bridge when that stops answering).
                if self.plugged:
                    self.rtt = ping(self.cable_ip) if self.cable_ip else None
                    if self.rtt is None:
                        self.cable_ip = pool.cable_peer()
                        self.rtt = ping(self.cable_ip)
                    self.cable = self.rtt is not None
                else:
                    self.cable, self.rtt = False, ping(self.lan_ip())
                # Anything on the wrong route on two checks in a row gets moved, and again every 30 s until it's right:
                # on Wi-Fi while the cable answers, or on a pulled cable.
                wrong = (self.plugged and self.cable and any(r != "cable" for r in self.routes)) or \
                        (not self.plugged and self.routes.get("cable", 0) > 0)
                self.wrong = self.wrong + 1 if wrong else 0
                if self.act and self.wrong >= 2 and (self.wrong - 2) % 10 == 0:
                    threading.Thread(target=self.move, args=(self.plugged,), daemon=True).start()
            except Exception as e:
                log(f"link check failed: {e!r}")
            if self.on_change and before != (self.cable, dict(self.routes)):
                self.on_change()
            n += 1
            self.wake.wait(3)

    def lan_ip(self):
        """The other Mac's address on the office network (what peer-route uses without the cable), looked up each
        minute from its Bonjour name."""
        if time.time() - self.lan[0] > 60:
            names = [f.name[len("peer-route-"):] for f in Path(HOME, ".cache").glob("peer-route-*")]
            out = sh(f"dscacheutil -q host -a name {shlex.quote(names[0])}") if names else ""
            ips = [ip for ip in re.findall(r"ip_address: (\S+)", out) if not ip.startswith("169.254.")]
            self.lan = (time.time(), ips[0] if ips else None)
        return self.lan[1]


def ping(ip):
    """Round trip to ip in milliseconds (one ICMP echo, a second at most), or None."""
    if not ip:
        return None
    m = re.search(r"time=([\d.]+) ms", sh(f"ping -c 1 -t 1 {shlex.quote(ip)}", timeout=3))
    return round(float(m.group(1)), 2) if m else None


def bridge_bytes():
    """(when, bytes in, bytes out) on the Thunderbolt bridge so far, or None. Only the Macs talk over it."""
    for line in sh("netstat -ibn -I bridge0").splitlines():
        f = line.split()
        if len(f) >= 10 and f[2].startswith("<Link#"):
            return time.time(), int(f[6]), int(f[9])
    return None


class Sampler:
    """What this Mac is doing: per-core CPU, memory, and each Claude session's process tree (CPU and memory of the
    session and everything it started), service, the busiest apps outside them, and the link to the other Mac."""

    def __init__(self, act=False, on_change=None):
        self.link = LinkWatch(act, on_change)
        self.static = layout()
        self.cores = Cores()
        self.prev_cpu, self.prev_t = {}, None
        self.transcripts = {}
        try:
            self.ws = pool.workspace()
        except (OSError, ImportError):
            self.ws = None
        self.slow = {}
        self.leftovers, self.leftovers_at = [], 0.0
        self.claude_pids, self.personal, self.closed = None, [], False
        self.refresh()
        threading.Thread(target=self.refresh_loop, daemon=True).start()

    def refresh_loop(self):
        """Which Mac you're using every 5 s (cheap); the rest every 15 s, or at once when a Claude process starts or
        ends. `claude agents` starts Node each time, which is most of what sampling costs."""
        n = 0
        while not self.closed:
            time.sleep(5)
            n += 1
            try:
                if n % 3 == 0 or self.claude_pids != self.slow.get("claude_pids"):
                    self.refresh(personal=n % 12 == 0)
                else:
                    self.slow = dict(self.slow, hid=hid_idle())
            except Exception as e:  # keep sampling with the last good values; the log says what broke
                log(f"sampler refresh failed: {e!r}")

    def refresh(self, personal=True):
        """The slower facts: the sessions `claude agents` knows (the legacy claude-personal profile only when
        personal is set), service's process, which sessions run here in pool's tmux for the other Mac's windows, which
        windows here show the other Mac's sessions, moves."""
        claude_pids = self.claude_pids
        agents = []
        for profile in ("claude", "claude-personal") if personal else ("claude",):
            out = sh(pool.PREAMBLE + f"command -v {profile} >/dev/null && {profile} agents --json 2>/dev/null || echo '[]'")
            try:
                found = [dict(a, profile=profile) for a in json.loads(out or "[]")]
            except ValueError:
                found = []
            if profile == "claude-personal":
                self.personal = found
            agents += found
        if not personal:
            agents += self.personal
        launchd = {int(f[0]) for f in (l.split() for l in sh("launchctl list").splitlines()[1:]) if f and f[0].isdigit()}
        service = None
        if SELF == OLD:
            m = re.search(r'"PID" = (\d+);', sh(f"launchctl list {pool.SERVICE_LABEL} 2>/dev/null"))
            service = int(m.group(1)) if m else None
        panes = {p: n for p, n in pool.pool_tmux_panes().items()
                 if n.startswith("pool-") and not n.startswith(("pool-sh-", "pool-home"))}
        try:
            moves = json.loads((STATE / "moves.json").read_text())
        except (OSError, ValueError):
            moves = {}
        mtime = {}
        for a in agents:
            sid = a.get("sessionId")
            if not (a.get("pid") and sid):
                continue
            path = self.transcripts.get(sid) or (self.ws.find_transcript(sid) if self.ws else None)
            try:
                mtime[sid] = os.stat(path).st_mtime if path else None
                self.transcripts[sid] = path
            except OSError:
                self.transcripts.pop(sid, None)
        self.slow = {"agents": agents, "service": service, "panes": panes, "moves": moves, "mtime": mtime, "launchd": launchd,
                     "shown": windows_showing_peer(), "hid": hid_idle(), "claude_pids": claude_pids}

    def find_leftovers(self, procs, rate, tree, now):
        """Process trees whose Claude session is gone (see leftover()), running at least LEFTOVER_AGE."""
        cands = [pid for pid, p in procs.items() if p[0] == 1 and pid not in self.slow["launchd"] and p[4] >= LEFTOVER_AGE
                 and (os.path.basename(p[3]) in ("zsh", "bash", "sh") or DEV_EXE.match(os.path.basename(p[3])))]
        if not cands:
            return []
        trees = {pid: tree(pid) for pid in cands}
        every = sorted({p for t in trees.values() for p in t})
        args = {}
        for line in sh("ps -o pid=,args= -p " + ",".join(map(str, every))).splitlines():
            pid, _, a = line.strip().partition(" ")
            if pid.isdigit():
                args[int(pid)] = a.strip()
        cwd, cur = {}, None
        for line in sh("lsof -a -d cwd -Fpn -p " + ",".join(map(str, cands))).splitlines():
            if line.startswith("p"):
                cur = int(line[1:])
            elif line.startswith("n") and cur:
                cwd[cur] = line[1:]
        out = []
        for pid in cands:
            a, t = args.get(pid, ""), trees[pid]
            watcher = SERVICE_WATCHER.search(a) if SERVICE_WATCHER and CLAUDE_SHELL.search(a) else None
            if not watcher and (not leftover(os.path.basename(procs[pid][3]), a, cwd.get(pid, ""))
                                or any(NEVER_CLOSE.search(args.get(p, "")) for p in t)):
                continue
            out.append({"pid": pid, "start": round(now - procs[pid][4]), "age": round(procs[pid][4]),
                        "cpu": round(sum(rate.get(p, 0) for p in t), 3), "rss": sum(procs[p][2] for p in t if p in procs),
                        "cwd": cwd.get(pid, ""), "n": len(t), "watcher": watcher.group(1) if watcher else None,
                        "what": "service watcher left by an ended session" if watcher else describe(t, args)})
        return out

    def sample(self):
        now = time.time()
        procs = processes()
        slow = self.slow
        dt = now - self.prev_t if self.prev_t else 0
        ncpu = self.static["ncpu"]
        rate = {}
        for pid, (_, cpu, _, _, _) in procs.items():
            before = self.prev_cpu.get(pid, 0.0)  # a process new since the last sample used all its time since then
            rate[pid] = min(ncpu, max(0.0, cpu - before) / dt) if dt else 0.0
        self.prev_cpu, self.prev_t = {pid: p[1] for pid, p in procs.items()}, now
        kids = collections.defaultdict(list)
        for pid, p in procs.items():
            kids[p[0]].append(pid)

        def tree(root):
            out, todo = [], [root]
            while todo:
                p = todo.pop()
                out.append(p)
                todo += kids.get(p, [])
            return out

        def where(pid, kind):
            if pid in slow["panes"]:
                return "moved"  # runs here in pool's tmux, shown in a window on the other Mac
            if kind == "background":
                return "bg"
            p = procs[pid][0]
            while p > 1 and p in procs:
                base = os.path.basename(procs[p][3])
                if base == "ghostty":
                    return "tab"
                if base == "tmux":
                    return "tmux"
                if "sshd" in base:
                    return "ssh"
                p = procs[p][0]
            return "other"

        # Claude session processes (not Claude Code's background machinery): a change makes the next refresh early
        # (10 s old, so a passing `claude agents` call, ours included, doesn't count)
        self.claude_pids = frozenset(pid for pid, p in procs.items() if os.path.basename(p[3]) == "claude" and p[4] >= 10)
        sessions, claimed, seen = [], set(), set()
        for a in slow["agents"]:
            pid = int(a.get("pid") or 0)
            if pid not in procs or pid in seen or not a.get("sessionId"):
                continue
            seen.add(pid)
            t = tree(pid)
            claimed.update(t)
            mt = slow["mtime"].get(a["sessionId"])
            sessions.append({"sid": a["sessionId"], "pid": pid, "profile": a.get("profile") or "claude",
                             "id": a.get("id") or "", "name": a.get("name") or "", "cwd": a.get("cwd") or "",
                             "kind": a.get("kind") or "", "status": a.get("status") or "",
                             "waiting": a.get("waitingFor") or "", "cpu": round(sum(rate[p] for p in t), 3),
                             "rss": sum(procs[p][2] for p in t), "idle": round(now - mt) if mt else None,
                             "where": where(pid, a.get("kind"))})
        service = None
        if slow["service"] in procs:
            t = tree(slow["service"])
            claimed.update(t)
            service = {"cpu": round(sum(rate[p] for p in t), 3), "rss": sum(procs[p][2] for p in t)}
        apps = collections.defaultdict(lambda: [0.0, 0])
        for pid, (_, _, rss, comm, _) in procs.items():
            if pid not in claimed:
                a = apps[app_name(comm)]
                a[0] += rate[pid]
                a[1] += rss
        top = sorted(([n, round(c, 2), r] for n, (c, r) in apps.items()), key=lambda x: -x[1])[:6]
        if now - self.leftovers_at >= 120 and dt:  # leftovers are 10+ minutes old, so every 2 minutes is plenty
            self.leftovers_at = now
            try:
                self.leftovers = self.find_leftovers(procs, rate, tree, now)
            except Exception as e:
                log(f"leftover scan failed: {e!r}")
        return {"host": SELF, "ts": now, **self.static, "cores": self.cores.usage(), "load": os.getloadavg(),
                "mem": memory(), "sessions": sessions, "service": service, "apps": top, "shown_here": slow["shown"],
                "moves": slow["moves"], "hid": slow["hid"], "leftovers": self.leftovers, "link": self.link.snapshot(),
                "service_up": slow["service"] is not None if SELF == OLD else None}


SHARED = STATE / "sample.json"  # PoolBar's agent publishes each sample of this Mac here


def publish(sample):
    tmp = SHARED.with_suffix(".tmp")
    tmp.write_text(json.dumps(sample, separators=(",", ":")))
    os.replace(tmp, SHARED)


def shared_sample(max_age):
    """The sample PoolBar's agent published last, if it's this Mac's and fresh."""
    try:
        s = json.loads(SHARED.read_text())
    except (OSError, ValueError):
        return None
    return s if s.get("host") == SELF and time.time() - s.get("ts", 0) < max_age else None


class LocalSamples:
    """This Mac's samples, so each Mac measures itself once: the ones PoolBar's agent publishes while it runs, else
    from a Sampler of our own (started when needed, stopped when the agent's are back)."""

    def __init__(self, interval):
        self.interval, self.sampler, self.last = interval, None, 0.0

    def next(self):
        while True:
            s = shared_sample(max(6.0, 3 * self.interval))
            if s:
                if self.sampler:
                    self.sampler.closed = self.sampler.link.closed = True
                    self.sampler = None
                if s["ts"] > self.last:
                    self.last = s["ts"]
                    return s
                time.sleep(0.4)
                continue
            if not self.sampler:
                self.sampler = Sampler()
                self.sampler.sample()  # the first one has no CPU deltas yet
            time.sleep(max(0.05, self.interval - (time.time() - self.last)))
            s = self.sampler.sample()
            self.last = s["ts"]
            return s


def stream(interval):
    """--stream: print this Mac's samples until whoever reads them goes away."""
    source = LocalSamples(interval)
    while True:
        s = source.next()
        try:
            print(json.dumps(s, separators=(",", ":")), flush=True)
        except BrokenPipeError:
            return
        if os.getppid() == 1:
            return


# --- both Macs ---

class Feed:
    """Samples from both Macs as they arrive: this Mac's from a Sampler, the other's streamed over ssh. Keeps an hour
    of history per Mac and five minutes of CPU per session."""

    def __init__(self, interval, peer=True, publish=False):
        self.interval, self.publish = interval, publish
        self.changed = threading.Event()  # set when the link changes, so the agent redraws without waiting
        self.watch = None
        self.lock = threading.Lock()
        self.latest = {}
        self.hist = {h: collections.deque(maxlen=int(3600 / interval) + 1) for h in (M5, OLD)}
        self.sess = {}
        self.peer_note = f"connecting to the {LABEL[PEER]}…"
        threading.Thread(target=self.local, daemon=True).start()
        if peer:
            threading.Thread(target=self.remote, daemon=True).start()

    def add(self, s):
        t = time.time()  # arrival time, so the other Mac's clock doesn't matter
        s["_at"] = t
        util = sum(c * w for c, w in zip(s["cores"], s["weights"])) / s["capacity"]
        m = s["mem"]
        n = int(300 / self.interval) + 1
        with self.lock:
            self.latest[s["host"]] = s
            self.hist[s["host"]].append((t, s["cores"], util, m["used"] / m["total"], m["level"], m["swap"]))
            live = set()
            for r in s["sessions"]:
                key = (s["host"], r["pid"])
                live.add(key)
                self.sess.setdefault(key, collections.deque(maxlen=n)).append(r["cpu"])
            for key in [k for k in self.sess if k[0] == s["host"] and k not in live]:
                del self.sess[key]

    def local(self):
        """PoolBar's agent samples this Mac and publishes each sample; anyone else reuses those (LocalSamples)."""
        if not self.publish:
            source = LocalSamples(self.interval)
            while True:
                try:
                    self.add(source.next())
                except Exception as e:
                    log(f"local sample failed: {e!r}")
                    time.sleep(self.interval)
        sampler = Sampler(act=True, on_change=self.changed.set)
        self.watch = sampler.link
        sampler.sample()
        while True:
            t = time.time()
            time.sleep(max(0.05, self.interval - (time.time() - t)))
            try:
                s = sampler.sample()
                publish(s)
                self.add(s)
            except Exception as e:
                log(f"local sample failed: {e!r}")

    def remote(self):
        cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=5",
               "-o", "ServerAliveCountMax=2", "-o", "ControlMaster=no", "-o", "ControlPath=none", pool.ALIAS[PEER],
               "bash -c " + shlex.quote(pool.PREAMBLE + f"exec python3 ~/.local/bin/pool-top --stream {self.interval}")]
        wait = 2
        while True:
            try:
                STATE.mkdir(parents=True, exist_ok=True)
                with open(STATE / "top.log", "a") as err:
                    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err, stdin=subprocess.DEVNULL, text=True)
                    for line in p.stdout:
                        try:
                            self.add(json.loads(line))
                        except (ValueError, KeyError, TypeError):
                            continue
                        self.peer_note, wait = "", 2
                    p.wait()
            except OSError as e:
                log(f"stream from the {LABEL[PEER]} failed: {e!r}")
            with self.lock:
                self.latest.pop(PEER, None)
            self.peer_note = f"can't reach the {LABEL[PEER]}; retrying"
            time.sleep(wait)
            wait = min(wait * 2, 30)

    def history(self, host):
        with self.lock:
            return list(self.hist[host])


class Meta:
    """Pins and the tiers Nick chose, refreshed in the background (reading service's sessions can take an ssh)."""

    def __init__(self):
        self.pins, self.chosen, self.service = set(pool.OLD_MAC_WORK), pool.chosen_tiers(), set()
        threading.Thread(target=self.loop, daemon=True).start()

    def loop(self):
        while True:
            try:
                self.service = pool.service_sessions()
                self.pins = pool.pinned()
            except Exception as e:
                log(f"reading pins failed: {e!r}")
            self.chosen = pool.chosen_tiers()
            time.sleep(15)

    def set_tier(self, sid, tier):
        chosen = dict(self.chosen)
        if tier == "auto":
            chosen.pop(sid[:8], None)
        else:
            chosen[sid[:8]] = tier
        self.chosen = chosen
        pool.set_tier(sid, tier)


# --- deciding what should move ---

def room(m, host):
    """Capacity left before the Mac's ceiling, in M1 performance cores."""
    return max(0.0, CEILING[host] - m["util"]) * m["capacity"]


def gb(n):
    return f"{n / GB:.1f} GB" if n >= GB else f"{n / MB:.0f} MB"


def cores(n):
    """CPU in cores: two decimals under one core (most Claude sessions use a few hundredths), one above."""
    return f"{n:.2f}" if n < 0.995 else f"{n:.1f}"


def place(s):
    moved = f"on the {LABEL[s['host']]} " + ("with no window" if s["window"] == "no window" else f"for the {s['window']}")
    return {"tab": f"in an {LABEL[s['host']]} tab", "moved": moved,
            "bg": f"in the background on the {LABEL[s['host']]}"}.get(s["where"], f"on the {LABEL[s['host']]}")


def ago(secs):
    if secs is None:
        return "?"
    if secs < 60:
        return "now"
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return "now"


def recommend(macs, sessions):
    """Suggested moves, most pressing first, at most one per session.

    macs: {host: {"util": share of capacity busy over the last minute, "capacity": in M1 performance cores,
    "level": share of memory free (kern.memorystatus_level), "free": bytes not in use, "total": bytes}}. With a Mac
    missing (out of reach), nothing is suggested.
    sessions: dicts with sid, pid, name, host, tier, why, status, where, units (5-minute CPU average in M1 cores),
    rss (bytes, with everything the session started), idle (seconds since its conversation changed, or None),
    movable, pinned and moved (moved in the last half hour).
    Returns dicts with sid, pid, name, where, src, dst, busy, why and level: 0 home work about to be left behind,
    1 a Mac past its ceiling or short of memory, 2 tidying up (worth doing, nothing suffers meanwhile)."""
    if M5 not in macs or OLD not in macs:
        return []
    out = {}

    def add(s, level, why, kind="move"):
        if s["sid"] not in out or level < out[s["sid"]]["level"]:
            out[s["sid"]] = {"sid": s["sid"], "pid": s["pid"], "name": s["name"], "where": s["where"],
                             "src": s["host"], "dst": OTHER[s["host"]], "level": level, "why": why, "kind": kind,
                             "busy": s["status"] == "busy"}

    def fits(s, dst, extra=0.0):
        m = macs[dst]
        return m["level"] >= MEM_TIGHT and m["util"] + (extra + s["units"]) / m["capacity"] < CEILING[dst]

    ok = [s for s in sessions if s["movable"] and not s["pinned"] and not s["moved"]]
    for s in ok:
        if s["tier"] == "home" and s["host"] == OLD:
            add(s, 0, f"home tier ({s['why']}) but running on {LABEL[OLD]}, so it stays behind when you take "
                      f"{LABEL[M5]} with you")
        elif s["tier"] == "m1" and s["host"] == M5 and fits(s, OLD):
            add(s, 2, f"stay-tier ({s['why']}); moving it frees {gb(s['rss'])} and its CPU on {LABEL[M5]}")
    for src in (M5, OLD):
        dst = OTHER[src]
        m, d = macs[src], macs[dst]
        floats = [s for s in ok if s["host"] == src and s["tier"] == "float"]
        if m["util"] >= CEILING[src] and room(d, dst) > room(m, src):
            excess, shed = (m["util"] - CEILING[src]) * m["capacity"], 0.0
            for s in sorted(floats, key=lambda s: -s["units"]):
                if shed >= excess or s["units"] < 0.25:
                    break
                if fits(s, dst, shed):
                    add(s, 1, f"the {LABEL[src]} has run at {m['util']:.0%} of its capacity for a minute (limit "
                              f"{CEILING[src]:.0%}); this session averaged {s['units']:.1f} cores over 5 min and the "
                              f"{LABEL[dst]} has {room(d, dst):.0f} to spare")
                    shed += s["units"]
        if m["level"] < MEM_TIGHT and d["level"] >= m["level"] + 10:
            need, freed = (MEM_TIGHT - m["level"]) / 100 * m["total"], 0
            for s in sorted(floats, key=lambda s: -s["rss"]):
                if freed >= need or s["rss"] < 512 * MB:
                    break
                if d["free"] > s["rss"] + 2 * GB:
                    add(s, 1, f"the {LABEL[src]} is short of memory ({m['level']}% free); this session holds "
                              f"{gb(s['rss'])} and the {LABEL[dst]} has {gb(d['free'])} free")
                    freed += s["rss"]
    # Keep the two within BALANCE_GAP of each other once either passes BALANCE_START: move the busiest float work
    # from the busier Mac until the projected gap is back inside it.
    hi = M5 if macs[M5]["util"] >= macs[OLD]["util"] else OLD
    lo = OTHER[hi]
    m, d = macs[hi], macs[lo]
    gap = m["util"] - d["util"]
    if m["util"] > BALANCE_START and gap > BALANCE_GAP:
        need = (gap - BALANCE_GAP) / (1 / m["capacity"] + 1 / d["capacity"])
        shed = 0.0
        for s in sorted((s for s in ok if s["host"] == hi and s["tier"] == "float"), key=lambda s: -s["units"]):
            if shed >= need or s["units"] < 0.25:
                break
            if fits(s, lo, shed):
                add(s, 1, f"the {LABEL[hi]} has averaged {m['util']:.0%} for a minute against {d['util']:.0%} on the "
                          f"{LABEL[lo]} (they should stay within {BALANCE_GAP:.0%}); this session averaged "
                          f"{s['units']:.1f} cores over 5 min")
                shed += s["units"]
    for s in ok:
        if s["tier"] != "float":
            continue
        if s["host"] == OLD and s["units"] >= 1.0 and room(macs[M5], M5) >= 2 * s["units"] and macs[M5]["util"] < 0.6:
            ratio = pool.SPEED[M5][0] / pool.SPEED[OLD][0]
            add(s, 2, f"busy on {LABEL[OLD]} ({s['units']:.1f} cores over 5 min); {LABEL[M5]} has {room(macs[M5], M5):.0f} "
                      f"to spare and its cores are about {ratio:.1f}x faster", "power")
        elif (s["host"] == M5 and s["status"] != "busy" and (s["idle"] or 0) >= 1800 and s["rss"] >= GB
              and macs[M5]["level"] < 50 and macs[OLD]["level"] >= macs[M5]["level"] + 10 and fits(s, OLD)):
            add(s, 2, f"idle for {ago(s['idle'])} and holding {gb(s['rss'])}; {LABEL[OLD]} has more memory to spare", "memory")
    return sorted(out.values(), key=lambda r: (r["level"], r["busy"]))


def duplicates(sessions):
    """The same conversation running in two processes (both write one transcript), as warnings."""
    by = collections.defaultdict(list)
    for s in sessions:
        by[s["sid"]].append(s)
    return [f"{sid[:8]} “{short(rs[0]['name'] or 'unnamed', 30)}” runs {len(rs)} times ("
            + " and ".join(place(r) for r in rs) + "): close one, both copies write the same conversation"
            for sid, rs in by.items() if len(rs) > 1]


WINDOW = {"tab": "{here} tab", "bg": "background", "tmux": "tmux", "ssh": "ssh", "other": "-"}


def view(feed, meta, now=None):
    """What the monitor, the menu bar and the popups show: each Mac's numbers, every session with its tier and its
    5-minute CPU average, the suggested moves and duplicate sessions."""
    now = now or time.time()
    stale = max(10, 5 * feed.interval)
    with feed.lock:
        latest = {h: s for h, s in feed.latest.items() if now - s["_at"] < stale}
        recent = {h: list(feed.hist[h])[-max(1, int(60 / feed.interval)):] for h in latest}
        cpu = {k: sum(v) / len(v) for k, v in feed.sess.items() if v}
    if feed.watch and SELF in latest:  # this Mac's link as of now, not as of the last sample
        latest[SELF] = dict(latest[SELF], link=feed.watch.snapshot())
    macs = {}
    for h, s in latest.items():
        m = s["mem"]
        macs[h] = {"util": sum(e[2] for e in recent[h]) / len(recent[h]), "util_now": recent[h][-1][2],
                   "capacity": s["capacity"], "ncpu": s["ncpu"], "level": m["level"], "total": m["total"],
                   "free": max(0, m["total"] - m["used"]), "used": m["used"], "swap": m["swap"], "hid": s.get("hid")}
    moves, shown = {}, {}
    for h, s in latest.items():
        for k, t in (s.get("moves") or {}).items():
            moves[k] = max(moves.get(k, 0), t)
        shown[h] = set(s.get("shown_here") or ())
    pin_paths = [p for p in meta.pins if p.startswith("/")]
    rows = []
    for h, s in latest.items():
        for r in s["sessions"]:
            tier, why = pool.tier_of(r["sid"], r["name"], r["cwd"], r["kind"], r["idle"], meta.pins, meta.chosen)
            avg = cpu.get((h, r["pid"]), r["cpu"])
            window = (f"{LABEL[OTHER[h]]} tab" if r["sid"] in shown.get(OTHER[h], ()) else "no window") \
                if r["where"] == "moved" else WINDOW[r["where"]].format(here=LABEL[h])
            rows.append(dict(r, host=h, tier=tier, why=why, auto=why != "set by you", cpu5=avg,
                             units=avg * s["capacity"] / s["ncpu"], window=window,
                             pinned=r["sid"][:8] in meta.pins or bool(pool.covering(r["cwd"], pin_paths)),
                             moved=now - moves.get(r["sid"][:8], 0) < 1800, movable=r["where"] in MOVABLE))
    dups = duplicates(rows)
    twice = {sid for sid, n in collections.Counter(r["sid"] for r in rows).items() if n > 1}
    for r in rows:
        r["movable"] = r["movable"] and r["sid"] not in twice
    recs = recommend(macs, rows)
    return {"now": now, "macs": macs, "latest": latest, "sessions": rows, "recs": recs, "dups": dups,
            "link": link_state(latest),
            "cleanup": cleanup(rows, latest, meta.service, twice), "imbalance": imbalance(macs, recs, latest),
            "service": latest[OLD].get("service_up") if OLD in latest else None}


def link_state(latest):
    """How the Macs are connected, from both sides' reports: "cable" when every connection between them is on the
    Thunderbolt cable, "moving" when the cable answers but some are still on Wi-Fi (the pool daemon moves them within
    a minute), "wifi" when there's no cable. None when a side hasn't reported (out of reach, or still starting)."""
    reports = {h: s.get("link") for h, s in latest.items() if s.get("link")}
    mine = reports.get(SELF) or next(iter(reports.values()), None)
    if not mine:
        return None
    plugged = lambda r: r.get("plugged", r.get("cable"))
    rtt = mine.get("rtt")
    speed = "–" if rtt is None else f"{rtt:.1f} ms" if rtt < 10 else f"{rtt:.0f} ms"
    if any(plugged(r) is False for r in reports.values()):  # one side says unplugged: that's final, no need to wait
        state, text = "wifi", "Over Wi-Fi (cable not plugged in)"
        off = None
    elif len(reports) < 2:
        return None
    else:
        routes = collections.Counter()
        for r in reports.values():
            routes.update(r["routes"])
        off = sum(n for route, n in routes.items() if route != "cable")
        if all(r.get("cable") for r in reports.values()) and not off:
            state, text = "cable", "Thunderbolt cable"
        else:
            state, text = "moving", (f"Cable plugged in, moving {off} connection{'s' if off != 1 else ''} off Wi-Fi"
                                     if off else "Cable plugged in, waiting for the other Mac to answer on it")
    rate = (mine.get("rx") or 0) + (mine.get("tx") or 0)
    detail = f"{speed} round trip" + (f" · {gb(rate)}/s crossing now" if state == "cable" and rate >= MB / 10 else "")
    return {"state": state, "text": f"{text} · {detail}", "speed": speed, "rtt": rtt, "off": off}


def cleanup(rows, latest, service_ids, twice):
    """What nobody is using, to offer closing, biggest first: sessions between turns and untouched for CLOSE_IDLE
    (their conversations are kept), and leftover processes whose Claude session is gone. service's sessions qualify
    like any other (an ended thread wakes a fresh session on Nick's next message, the way service already treats
    threads whose session wound down); service's own processes and Claude's background machinery never do."""
    items = []
    for r in rows:
        if r["status"] != "idle" or (r["idle"] or 0) < CLOSE_IDLE or r["sid"] in twice:
            continue
        note = ("service wakes a fresh session for its thread on your next message there" if r["sid"][:8] in service_ids
                else f"conversation kept: claude attach {r.get('id') or r['sid'][:8]}" if r["kind"] == "background"
                else f"conversation kept: claude --resume {r['sid'][:8]}")
        items.append({"key": "s:" + r["sid"][:8], "host": r["host"], "kind": "session", "label": r["name"] or r["sid"][:8],
                      "detail": f"idle {ago(r['idle'])}, {gb(r['rss'])}", "note": note, "rss": r["rss"],
                      "spec": "|".join([SHORT[r["host"]], "session", r["sid"], str(r["pid"]), r.get("profile") or "claude",
                                        r["kind"], r.get("id") or ""])})
    for h, s in latest.items():
        for o in s.get("leftovers") or []:
            items.append({"key": f"p:{SHORT[h]}:{o['pid']}:{o['start']}", "host": h,
                          "kind": "watcher" if o.get("watcher") else "leftover", "label": o["what"],
                          "detail": f"no session, running {ago(o['age'])}, {gb(o['rss'])}"
                                    + (f", {cores(o['cpu'])} cores" if o["cpu"] >= 0.1 else ""),
                          "note": f"thread {o['watcher']}: it can take your next follow-up there before service's new session sees it"
                                  if o.get("watcher") else "in " + (o["cwd"].replace(HOME, "~") or "?"),
                          "rss": o["rss"], "spec": f"{SHORT[h]}|procs|{o['pid']}|{o['start']}"})
    # service's dead watchers first (they can lose a message), then whatever holds the most memory
    return sorted(items, key=lambda i: (i["kind"] != "watcher", -i["rss"]))


def imbalance(macs, recs, latest):
    """When the Macs are further apart than BALANCE_GAP but no Claude session there is busy enough to move, say what
    the load is instead, so the gap isn't a mystery. None otherwise."""
    if M5 not in macs or OLD not in macs:
        return None
    hi = M5 if macs[M5]["util"] >= macs[OLD]["util"] else OLD
    lo = OTHER[hi]
    if macs[hi]["util"] <= BALANCE_START or macs[hi]["util"] - macs[lo]["util"] <= BALANCE_GAP:
        return None
    if any(r["src"] == hi and r["level"] <= 1 for r in recs):
        return None
    apps = ", ".join(f"{n} {cores(c)}" for n, c, _ in latest[hi]["apps"][:3] if c >= 0.1)
    return (f"The {LABEL[hi]} is at {macs[hi]['util']:.0%} against {macs[lo]['util']:.0%} on the {LABEL[lo]}, but no Claude "
            f"session there is busy enough to move" + (f"; the load is {apps} (cores)" if apps else ""))


def do_move(sid, where, dst):
    """Move session sid to dst: a Ghostty tab with `pool tab` (what /change-computer runs; its window stays and the
    conversation resumes on the other Mac), a background session with `pool move`. Returns (ok, message)."""
    pool_cmd = [sys.executable, POOL]
    try:
        if where in ("tab", "moved"):
            # --show: a move the user clicked, so pool brings Ghostty forward to make the reconnect visible
            p = subprocess.run(pool_cmd + ["tab", sid, "--show"], capture_output=True, text=True, timeout=120)
            ok, msg = p.returncode == 0, (p.stdout + p.stderr).strip()
        elif where == "bg":
            if SELF == M5:
                p = subprocess.run(pool_cmd + ["move", sid, "--to", SHORT[dst]], capture_output=True, text=True, timeout=900)
                ok, msg = p.returncode == 0, (p.stdout + p.stderr).strip()
            else:
                status, out = pool.peer(f"pool move {shlex.quote(sid)} --to {SHORT[dst]} 2>&1", timeout=900)
                ok, msg = status == 0, out.strip()
        else:
            return False, "it isn't in a Ghostty tab or in the background, so pool can't move it"
    except subprocess.TimeoutExpired:
        return False, "the move timed out"
    if ok:
        pool.record_move(sid)
    return ok, msg or ("moving it" if ok else "the move failed")


def snoozed():
    try:
        d = json.loads(SNOOZED.read_text())
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in d.items() if v > time.time()}


def snooze(keys, minutes):
    """No popup about these for a while, on both Macs (whichever you're at shows the popups). A move suggestion's key
    is its session's first 8 characters; cleanup items and "service" have their own."""
    d = snoozed()
    for k in keys:
        d[k] = time.time() + minutes * 60
    STATE.mkdir(parents=True, exist_ok=True)
    SNOOZED.write_text(json.dumps(d))
    pool.peer("mkdir -p ~/.local/state/pool && cat > ~/.local/state/pool/snoozed.json", input=json.dumps(d))


def kill_tree(root, grace=5.0):
    """Stop root and everything it started: SIGTERM root first (Claude shuts its own tools down), then what's left,
    then SIGKILL whatever ignores that. Returns how many processes were running."""
    procs = processes()
    kids = collections.defaultdict(list)
    for pid, p in procs.items():
        kids[p[0]].append(pid)
    tree, todo = [], [root]
    while todo:
        p = todo.pop()
        tree.append(p)
        todo += kids.get(p, [])

    def alive(pids):
        out = []
        for p in pids:
            try:
                os.kill(p, 0)
                out.append(p)
            except OSError:
                pass
        return out

    for step, sig, wait in ((0, signal.SIGTERM, grace), (1, signal.SIGTERM, 2.0), (2, signal.SIGKILL, 1.0)):
        targets = alive([root] if step == 0 else tree)
        if not targets:
            break
        for p in targets:
            try:
                os.kill(p, sig)
            except OSError:
                pass
        deadline = time.time() + wait
        while time.time() < deadline and alive(targets):
            time.sleep(0.2)
    return len(tree)


def close_here(spec):
    """Close one item on this Mac if it is still what was offered (same session and process, or the same adopted
    process by start time), so a reused pid is never hit. Returns (ok, message)."""
    f = (spec.split("|") + [""] * 7)[:7]
    if f[1] == "session":
        sid, pid, profile, kind, short_id = f[2], int(f[3] or 0), f[4] or "claude", f[5], f[6]
        out = sh(pool.PREAMBLE + f"{profile} agents --json 2>/dev/null || echo '[]'")
        try:
            live = [a for a in json.loads(out or "[]") if a.get("sessionId") == sid and int(a.get("pid") or 0) == pid]
        except ValueError:
            live = []
        if not live:
            return True, f"{sid[:8]} had already ended"
        if kind == "background" and short_id:
            sh(pool.PREAMBLE + f"{profile} stop {shlex.quote(short_id)} 2>&1")
            deadline = time.time() + 8
            while time.time() < deadline:
                try:
                    os.kill(pid, 0)
                except OSError:
                    return True, f"stopped {sid[:8]}"
                time.sleep(0.3)
        kill_tree(pid)
        return True, f"closed {sid[:8]}"
    if f[1] == "procs":
        pid, start = int(f[2] or 0), int(f[3] or 0)
        p = processes().get(pid)
        if not p or p[0] != 1 or abs((time.time() - p[4]) - start) > 15:
            return True, f"process {pid} had already gone"
        n = kill_tree(pid)
        return True, f"closed process {pid}" + (f" and {n - 1} under it" if n > 1 else "")
    return False, f"don't know how to close {spec!r}"


def close(specs):
    """Close items on either Mac (each runs where it lives). Returns (all ok, message)."""
    here = [s for s in specs if pool.SHORT.get(s.split("|")[0]) == SELF]
    there = [s for s in specs if s not in here]
    results = [close_here(s) for s in here]
    if there:
        status, out = pool.peer("python3 ~/.local/bin/pool-top --close " + " ".join(shlex.quote(s) for s in there),
                                timeout=180)
        results.append((status == 0, out.strip() or f"no answer from the {LABEL[PEER]}"))
    ok = all(r[0] for r in results)
    return ok, "; ".join(r[1] for r in results if r[1])


def using_this_mac(macs):
    """Whether you're at this Mac rather than the other: the one whose keyboard or pointer moved last."""
    here, there = macs.get(SELF, {}).get("hid"), macs.get(PEER, {}).get("hid")
    if there is None:
        return True
    if here is None:
        return False
    return here < there or (here == there and SELF == M5)


CLEANUP_EVERY = 1200   # seconds between cleanup popups
TRANSFER_EVERY = 1200  # seconds between optional "run it on the other Mac for more power" popups


class Popups:
    """What to pop up, one at a time and only on the Mac you're using: service down for two minutes first; then a move
    that has stood 30 s for a session between turns (a move cuts a turn off), at most one new one a minute (tidy-ups,
    level 2, stay in the menu); then one batch of things nobody is using, at most every CLEANUP_EVERY. Snoozed items
    are skipped."""

    def __init__(self, now=None):
        self.first, self.current, self.offered = {}, None, 0.0
        self.batch, self.batch_at = None, -1e9
        self.transfer_at = -1e9
        self.service_since, self.started = None, now if now is not None else time.time()

    def pick(self, v, here_active, snoozes, now):
        """The move to pop up, or None. Urgent moves (level 0/1: home work stranded on the M1, an overloaded or
        memory-short Mac) stand 30 s and wait until the session is between turns, so a move never cuts off a turn to
        relieve load. Transfers for more power (level 2: a busy task that the other Mac would run faster, or idle work
        that frees memory) stand 90 s and come at most every TRANSFER_EVERY; a busy one is offered with a warning that
        the move restarts its current step."""
        keys = {r["sid"] + ">" + r["dst"]: r for r in v["recs"]}
        self.first = {k: self.first.get(k, now) for k in keys}
        if not here_active:
            return None
        for k, r in keys.items():
            transfer = r["level"] >= 2
            if snoozes.get(r["sid"][:8], 0) > now or now - self.first[k] < (90 if transfer else 30):
                continue
            if r["busy"] and not transfer:            # an urgent move waits for the turn to end
                continue
            if transfer and k != self.current and now - self.transfer_at < TRANSFER_EVERY:
                continue
            if k != self.current:
                if now - self.offered < 60:
                    return None
                self.current, self.offered = k, now
                if transfer:
                    self.transfer_at = now
            return r
        self.current = None
        return None

    def pick_cleanup(self, items, here_active, snoozes, now):
        live = {i["key"]: i for i in items if snoozes.get(i["key"], 0) <= now}
        if self.batch and not any(k in live for k in self.batch["keys"]):
            self.batch = None
        if self.batch:
            return self.batch if here_active else None
        if (not here_active or not live or now - self.started < 60 or now - self.batch_at < CLEANUP_EVERY
                or now - self.offered < 60):
            return None
        chosen = list(live.values())[:6]
        self.batch = {"key": f"close:{int(now)}", "keys": [i["key"] for i in chosen], "items": chosen}
        self.batch_at = self.offered = now
        return self.batch

    def service_down(self, up, now):
        """Seconds service's bridge has been down on the M1 (None while it runs or the M1 can't be reached)."""
        self.service_since = (self.service_since or now) if up is False else None
        return now - self.service_since if self.service_since is not None else None


def service_load(v, host):
    """(cores, bytes) for service's own process plus the sessions pinned to the M1 on host, or None if there are none."""
    s = v["latest"].get(host) or {}
    pinned = [r for r in v["sessions"] if r["host"] == host and r["pinned"]]
    if not s.get("service") and not pinned:
        return None
    b = s.get("service") or {"cpu": 0.0, "rss": 0}
    return b["cpu"] + sum(r["cpu5"] for r in pinned), b["rss"] + sum(r["rss"] for r in pinned)


def short(text, n):
    return text if len(text) <= n else text[: n - 1] + "…"


def move_args(r):
