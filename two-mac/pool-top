        mem = "ok" if m["level"] >= MEM_TIGHT else "tight" if m["level"] >= MEM_LOW else "low"
        line = (f"{LABEL[h]}  CPU {m['util_now']:.0%} of capacity ({room(m, h):.0f} to spare) · "
                f"RAM {m['used'] / GB:.1f} of {m['total'] / GB:.0f} GB, memory {mem}")
        service = service_load(v, h)
        if service:
            line += f" · service and its sessions {cores(service[0])} cores, {gb(service[1])}"
        lines.append(line)
    snoozes = snoozed()
    recs = [{"text": f"Move “{short(r['name'] or r['sid'][:8], 46)}” to the {LABEL[r['dst']]}", "why": r["why"],
             "level": r["level"], "busy": r["busy"], "args": move_args(r), "key": r["sid"] + ">" + r["dst"],
