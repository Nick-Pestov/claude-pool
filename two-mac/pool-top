    by_sid = {r["sid"]: r for r in v["recs"]}
    sessions = {}
    for h in (M5, OLD):
        rows = []
        for s in sorted((s for s in v["sessions"] if s["host"] == h), key=lambda s: (s["pinned"], s["status"] != "busy", -s["units"])):
            text = (f"{short(s['name'] or s['sid'][:8], 44)}   {s['status']} · {cores(s['cpu5'])} cores · {gb(s['rss'])}"
                    f" · {s['tier']}{'' if s['auto'] else ' (yours)'}")
            rows.append({"text": text, "sid": s["sid"], "pinned": s["pinned"], "tier": s["tier"], "auto": s["auto"],
                         "why": s["why"], "suggested": s["sid"] in by_sid,
                         "move": {"text": f"Move to the {LABEL[OTHER[h]]}" + (" (cuts off its turn)" if s["status"] == "busy" else ""),
                                  "args": ["--move", s["sid"], s["where"], SHORT[OTHER[h]]]}
                         if s["movable"] and not s["pinned"] else None})
        sessions[LABEL[h]] = rows
    idle = [{"text": f"Close “{short(i['label'], 44)}” on the {LABEL[i['host']]}", "detail": f"{i['detail']} · {i['note']}",
             "args": ["--close", i["spec"]], "keep": ["--snooze-keys", "1440", i["key"]],
             "keepWeek": ["--snooze-keys", "10080", i["key"]]}
            for i in v["cleanup"] if snoozes.get(i["key"], 0) <= time.time()]
    service = v.get("service")
    palette = {LABEL[h]: pool.CONF["colors"].get(LABEL[h], "blue") for h in (M5, OLD)}
    out = {"palette": palette, "title": title, "alert": sum(1 for r in v["recs"] if r["level"] <= 1), "count": len(v["recs"]),
           "macs": lines, "recs": recs, "warnings": v["dups"] + ([v["imbalance"]] if v.get("imbalance") else []),
           "sessions": sessions, "idle": idle, "closeAll": ["--close"] + [i["spec"] for i in v["cleanup"]
                                                                          if snoozes.get(i["key"], 0) <= time.time()],
           "link": v.get("link"),
           "service": None if service is None else {"up": bool(service), "text": "service is running on the M1" if service
                                              else "service isn't running on the M1"},
           "popup": popup, "live": list(live)}
    return out


def agent(interval=2.0, count=None):
    """--agent: a JSON line for PoolBar every interval seconds."""
    if not os.environ.get("SSH_CONNECTION") and not os.environ.get("POOL_TOP_NO_TMUX"):
        # From the desktop session, so sessions moved onto this Mac can sign in (see pool's POOL_TMUX).
        pool.desktop_tmux_here()
    feed, meta, popups = Feed(interval, publish=True), Meta(), Popups()
    n = 0
    while count is None or n < count:
        feed.changed.wait(interval)  # a link change redraws at once
        feed.changed.clear()
        now = time.time()
        v = view(feed, meta, now)
        here, snoozes = using_this_mac(v["macs"]), snoozed()
        down = popups.service_down(v["service"], now)
        live = [r["sid"] + ">" + r["dst"] for r in v["recs"] if snoozes.get(r["sid"][:8], 0) <= now]
        popup = None
        if down is not None and down >= 120 and snoozes.get("service", 0) <= now:
            live.append("service-down")
            popup = service_popup(down) if here else None
        if not popup:
            pick = popups.pick(v, here, snoozes, now)
            popup = move_popup(pick) if pick else None
        batch = popups.pick_cleanup(v["cleanup"], here, snoozes, now)
        if popups.batch:
            live.append(popups.batch["key"])
        if not popup and batch:
            popup = cleanup_popup(batch)
        try:
            print(json.dumps(menu_state(v, popup, live)), flush=True)
        except BrokenPipeError:
            return
        n += 1


