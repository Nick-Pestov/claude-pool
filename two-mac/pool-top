    title = (f"Run this on the {LABEL[r['dst']]} for more power?" if r.get("kind") == "power"
             else f"Free up the {LABEL[r['src']]}: move this to the {LABEL[r['dst']]}?" if transfer
             else f"Move a Claude session to the {LABEL[r['dst']]}")
